#!/usr/bin/env bash
# ============================================================================
# needrestart-lxc-ss - script-server wrapper for needrestart-lxc.
#
# Installed on the cdist control host as ~cdist/bin/needrestart-lxc-ss (a
# symlink into the needrestart-lxc.git checkout under files.external/) and
# invoked by the script-server runners in /etc/script-server-dev/runners/ as
# `sudo -u cdist -i needrestart-lxc-ss ...`. It reaches the PVE hosts over the
# cdist user's root SSH and runs /usr/local/bin/needrestart-lxc there
# (deployed by cdist, see config/manifest/autorun/zabbix-agent-config).
#
# Subcommands:
#   hosts
#       Print the PVE host FQDNs that have needrestart-lxc deployed (explorer
#       distro == proxmox and a zabbix agent config present), one per line.
#       Used by the runners as their dynamic value list.
#   status [--mode scan|cached] HOST [HOST...]
#       Per-host report of containers needing service restarts.
#         scan   = run `needrestart-lxc --zabbix` on each host (default;
#                  fresh data incl. CVE analysis, warms the hosts' 24h cache)
#         cached = read the JSON the hosts' 15-min cron writes (instant,
#                  up to 15 minutes old)
#       Output: HTML tables. Rows with services to restart deep-link into the
#       "restart" runner with Host/Container/Action pre-filled.
#   restart --host FQDN [--container CTID|NAME]... [--exclude REGEX]
#           [--action dry-run|restart]
#       Run `needrestart-lxc [-n] -r [-c ID[,ID...]] [-e REGEX]` on one host.
#       dry-run (default) shows what would be restarted; restart actually
#       restarts the flagged services (including the escalation ladder).
#   containers --host FQDN
#       List the containers of one host that currently have services to
#       restart (from the host's cached report), one per line - the value
#       list for the restart runner's dynamic Container multiselect.
# ============================================================================
set -euo pipefail

SSH_OPTS=(-o ConnectTimeout=10 -o BatchMode=yes -o StrictHostKeyChecking=accept-new)
SCAN_TIMEOUT=300          # per-host remote scan timeout, seconds
RESTART_RUNNER="restart"

usage() {
    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
}

list_hosts() {
    # Hosts where the needrestart-lxc deployment actually applies: the
    # zabbix-agent-config manifest is gated on files/zabbix/agents/<fqdn>
    # (config repo) and the needrestart-lxc block on distro == proxmox
    # (explorer data). Require both so hosts without the binary don't show up
    # as permanent failures in the value list.
    local f
    for f in /home/cdist/explore/*/distro; do
        [[ -r "$f" ]] || continue
        [[ $(<"$f") == proxmox ]] || continue
        local fqdn
        fqdn=$(basename "$(dirname "$f")")
        [[ -f /home/cdist/config/files/zabbix/agents/$fqdn ]] || continue
        echo "$fqdn"
    done
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

# run_on <host> <outfile> <errfile>
# Fresh scan: `needrestart-lxc --zabbix` prints the JSON to stdout and any
# analysis notes to stderr. Cached: the agent UserParameter's file read.
run_on() {
    local host=$1 out=$2 err=$3 cached=${4:-}
    if [[ $cached == cached ]]; then
        timeout $((SCAN_TIMEOUT + 30)) ssh "${SSH_OPTS[@]}" "$host" \
            "cat /var/cache/needrestart-lxc/zabbix.json" \
            >"$out" 2>"$err"
    else
        timeout $((SCAN_TIMEOUT + 30)) ssh "${SSH_OPTS[@]}" "$host" \
            "timeout $SCAN_TIMEOUT /usr/local/bin/needrestart-lxc --zabbix" \
            >"$out" 2>"$err"
    fi
}

do_status() {
    local hosts=()
    while (($#)); do
        case $1 in
            --mode) [[ -n ${2:-} ]] || { echo "missing argument after $1"; exit 1; }
                    MODE=$2; shift 2 ;;
            --mode=*) MODE=${1#*=}; shift ;;
            -h|--help) usage ;;
            *) hosts+=("$1"); shift ;;
        esac
    done
    MODE=${MODE:-scan}
    [[ $MODE == scan || $MODE == cached ]] || { echo "bad --mode: $MODE"; exit 1; }
    ((${#hosts[@]})) || { echo "no hosts selected"; exit 1; }

    # Global (not local): the EXIT trap below must still see it at script
    # exit, where function locals are out of scope (set -u would abort).
    STATUS_TMP=$(mktemp -d)
    trap 'rm -rf "$STATUS_TMP"' EXIT

    local h pids=()
    for h in "${hosts[@]}"; do
        : >"$STATUS_TMP/$h.json"; : >"$STATUS_TMP/$h.err"; : >"$STATUS_TMP/$h.rc"
        ( if run_on "$h" "$STATUS_TMP/$h.json" "$STATUS_TMP/$h.err" "$MODE"; then
              echo 0 >"$STATUS_TMP/$h.rc"
          else
              echo $? >"$STATUS_TMP/$h.rc"
          fi ) &
        pids+=("$!")
    done
    local rc=0
    for p in "${pids[@]}"; do wait "$p" || rc=1; done

    python3 - "$STATUS_TMP" "$MODE" "$RESTART_RUNNER" <<'PYEOF'
import glob, html, json, os, sys
from datetime import datetime
from urllib.parse import quote

tmpdir, mode, restart_runner = sys.argv[1], sys.argv[2], sys.argv[3]
runner_enc = quote(restart_runner, safe="")


def esc(s):
    return html.escape(str(s), quote=True)


def restart_query(host, cvals, action="dry-run"):
    # one parameter per value: the runner's Container param is a multiselect,
    # and its prefill does not split comma strings; vue-router turns repeated
    # query keys into the array the multiselect expects.
    parts = [f"Host={quote(host, safe='')}"]
    parts += [f"Container={quote(v, safe='')}" for v in cvals]
    parts.append(f"Action={quote(action, safe='')}")
    return "&amp;".join(parts)


def restart_link(host, cval):
    return f"#/{runner_enc}?{restart_query(host, [cval])}"


STATE = {0: ("#1a7f37", "clean"), 1: ("#9a6700", "restart"), 2: ("#cf222e", "CVEs")}


def badge(state):
    color, label = STATE.get(state, ("#6e7781", f"state {state}"))
    return (f'<span style="background:{color};color:#fff;padding:1px 8px;'
            f'border-radius:10px;font-size:smaller">{label}</span>')


# details lines are "svc_display: verdict" (svc_display may carry a
# " (non-systemd)" or " [user session UID n]" suffix); bold the service so
# the lines scan quickly, verdict stays normal.
def fmt_details(raw):
    out = []
    for line in str(raw or "").split("\n"):
        e = esc(line)
        svc, sep, rest = e.partition(": ")
        out.append(f"<b>{svc}</b>: {rest}" if sep else e)
    return "\n".join(out)


# Interactive report (checkboxes + buttons) requires script-server's
# output_format=html_iframe: the plain html format is DOMPurify-sanitized,
# which strips <script>. The runner JSON sets html_iframe; the output is a
# complete HTML document written into the iframe's srcdoc, so a full document
# with <style> and <script> is fine here. The iframe element itself gets the
# .log-content class in the run page (fixed height, own scrollbar), so the
# window no longer grows while chunks stream in and the view stays at the top.
# JS jumps to the parent app's runner via window.top (same-origin srcdoc).
print("<!DOCTYPE html><html><head><meta charset='utf-8'><style>")
print("body{font-family:'Segoe UI',Helvetica,Arial,sans-serif;margin:8px}")
print("table{border-collapse:collapse;font-size:small}")
print("td,th{white-space:nowrap;text-align:left}")
print("td.name{max-width:24ch;overflow:hidden;text-overflow:ellipsis}")
print("td.details{white-space:pre-wrap}")
print("td.sel{text-align:center;width:1%}")
print("button{padding:2px 10px;font-size:smaller;cursor:pointer}")
print("p.failed{color:#cf222e}")
print("p.notes{font-size:smaller;color:#6e7781}")
print("p.meta{font-size:smaller}")
print("</style><script>")
print(f"var RUNNER = {restart_runner!r};")
print("""
function toggleAll(master) {
    var boxes = document.querySelectorAll('input.rsel');
    for (var i = 0; i < boxes.length; i++) boxes[i].checked = master.checked;
}
function go(host, action) {
    var boxes = document.querySelectorAll('input.rsel:checked');
    if (!boxes.length) { alert('No containers selected on ' + host + '.'); return; }
    var vals = [];
    for (var i = 0; i < boxes.length; i++) vals.push(boxes[i].value);
    var q = 'Host=' + encodeURIComponent(host) +
            '&Action=' + encodeURIComponent(action);
    for (var i = 0; i < vals.length; i++)
        q += '&Container=' + encodeURIComponent(vals[i]);
    window.top.location.hash = '#/' + encodeURIComponent(RUNNER) + '?' + q;
}
</script></head><body>""")
print(f"<p class=meta>mode: {esc(mode)} &mdash; generated {esc(datetime.now().strftime('%Y-%m-%d %H:%M:%S'))}</p>")

total_svc = total_cve = 0
files = sorted(glob.glob(os.path.join(tmpdir, "*.json")))
for path in files:
    host = os.path.basename(path)[:-len(".json")]
    err = open(path[:-len("json")] + "err").read().strip()
    rc = open(path[:-len("json")] + "rc").read().strip()
    try:
        containers = json.load(open(path)).get("containers", [])
    except ValueError:
        containers = None

    if containers is None:
        print(f"<h3>{esc(host)}</h3>")
        print(f'<p class=failed><b>failed</b> (rc {esc(rc)}):'
              f"<pre>{esc(err[-2000:]) or 'no output'}</pre></p>")
        continue

    # CVE-affected first, then plain restarts, clean last; CTID order within
    # each group (stable sort on ctid).
    containers = sorted(
        containers,
        key=lambda c: (-c.get("state", 0),
                       int(c["ctid"]) if str(c.get("ctid", "")).isdigit() else 0))
    flagged = [c for c in containers if c.get("services", 0) > 0]
    total_svc += sum(c["services"] for c in flagged)
    total_cve += sum(c.get("cves", 0) for c in flagged)
    print(f"<h3>{esc(host)} "
          f'<button onclick="go(\'{esc(host)}\',\'dry-run\')" '
          f"title='open the restart runner with the ticked containers, dry-run preselected'>"
          f"go to restart</button></h3>")
    print(f'<p class=meta>{len(flagged)} of {len(containers)} '
          f"container(s) need a restart</p>")
    print("<table border=1 cellpadding=4 cellspacing=0>")
    th = "<th>"
    print(f"<tr><th title='tick to select/deselect all containers'>"
          f"<input type=checkbox onchange=\"toggleAll(this)\"></th>{th}CT</th>{th}Name</th>"
          f"{th}Services</th>{th}CVEs</th>{th}State</th>{th}Details</th></tr>")
    # Deep links must prefill the restart runner's Container multiselect, whose
    # values are the container name (unique) or the CTID (ambigous/unknown 
    # names) - same rule as the `containers` subcommand.
    all_names = [c.get("name") for c in containers]
    for c in containers:
        svc, cves = c.get("services", 0), c.get("cves", 0)
        if svc == 0:
            continue  # clean containers: no findings, not shown
        details = fmt_details(c.get("details"))
        ct = esc(c.get("ctid", "?"))
        if svc > 0:
            cname = c.get("name")
            cval = (cname if cname and cname != "unknown"
                    and all_names.count(cname) == 1 else c.get("ctid", ""))
            href = restart_link(host, cval)
            ct = (f'<a target="_top" href="{href}" '
                  f'title="open restart runner (dry-run)">{ct}</a>')
            sel = f'<input type=checkbox class=rsel value="{esc(cval)}">'
        else:
            sel = ""
        name = esc(c.get("name", "?"))
        print(f'<tr><td class=sel>{sel}</td><td>{ct}</td>'
              f'<td class=name title="{name}">{name}</td>'
              f"<td style='text-align:right'>{svc}</td>"
              f"<td style='text-align:right'>{cves}</td>"
              f"<td>{badge(c.get('state', 0))}</td>"
              f"<td class=details>{details}</td></tr>")
    print("</table>")
    if err:
        print(f'<p class=notes>notes:'
              f"<pre style='margin:2px'>{esc(err[-2000:])}</pre></p>")

print(f"<hr><p><b>Totals:</b> {total_svc} service(s), {total_cve} CVE(s) "
      f"across {len(files)} host(s).</p>")
print("</body></html>")
PYEOF
    return $rc
}

# ---------------------------------------------------------------------------
# restart
# ---------------------------------------------------------------------------

# shquote <string>
# POSIX-safe single-quoted form for embedding into a remote shell command.
# ssh re-joins argv into one string and runs it through the remote login
# shell, so unquoted user input from the script-server UI would be
# interpreted there (as root on the PVE host).
shquote() {
    local s=${1//\'/\'\\\'\'}
    printf "'%s'" "$s"
}

do_containers() {
    local host=""
    while (($#)); do
        case $1 in
            --host) [[ -n ${2:-} ]] || { echo "missing argument after $1"; exit 1; }
                    host=$2; shift 2 ;;
            -h|--help) usage ;;
            *) echo "unknown containers option: $1"; exit 1 ;;
        esac
    done
    [[ -n $host ]] || { echo "--host is required"; exit 1; }

    # Read the host's cached report (instant; the restart run itself rescans
    # fresh, so staleness only affects what the checkbox list offers).
    local out err rc
    out=$(mktemp); err=$(mktemp)
    run_on "$host" "$out" "$err" cached
    rc=$?
    if ((rc != 0)); then
        echo "failed to read cached report from $host (rc $rc)" >&2
        rm -f "$out" "$err"
        exit 1
    fi
    python3 - "$out" <<'PYEOF'
import json, sys

# One line per container that has services to restart. The line IS the value
# passed to needrestart-lxc -c, so it must resolve to exactly one container:
# use the container name when unique, else the CTID.
data = json.load(open(sys.argv[1]))
containers = [c for c in data.get("containers", []) if c.get("services", 0) > 0]
names = [c.get("name") for c in containers]
containers.sort(key=lambda c: (-c.get("state", 0),
                               int(c["ctid"]) if str(c.get("ctid", "")).isdigit() else 0))
for c in containers:
    name = c.get("name")
    print(name if name and name != "unknown" and names.count(name) == 1
          else str(c.get("ctid", "?")))
PYEOF
    rm -f "$out" "$err"
}

do_restart() {
    local host="" exclude="" action="dry-run"
    local -a containers=()
    while (($#)); do
        case $1 in
            --host) [[ -n ${2:-} ]] || { echo "missing argument after $1"; exit 1; }
                    host=$2; shift 2 ;;
            --container) [[ -n ${2:-} ]] || { echo "missing argument after $1"; exit 1; }
                    containers+=("$2"); shift 2 ;;
            --exclude) [[ -n ${2:-} ]] || { echo "missing argument after $1"; exit 1; }
                    exclude=$2; shift 2 ;;
            --action) [[ -n ${2:-} ]] || { echo "missing argument after $1"; exit 1; }
                    action=$2; shift 2 ;;
            -h|--help) usage ;;
            *) echo "unknown restart option: $1"; exit 1 ;;
        esac
    done
    [[ -n $host ]] || { echo "--host is required"; exit 1; }
    [[ $action == dry-run || $action == restart ]] || { echo "bad --action: $action"; exit 1; }

    local remote="/usr/local/bin/needrestart-lxc"
    [[ $action == dry-run ]] && remote+=" -n"
    remote+=" -r"
    ((${#containers[@]})) && remote+=" -c $(shquote "$(IFS=,; echo "${containers[*]}")")"
    [[ -n $exclude ]] && remote+=" -e $(shquote "$exclude")"

    local cmd=(ssh "${SSH_OPTS[@]}" "$host" -- "$remote")

    echo "Running: ${cmd[*]}"
    echo
    exec "${cmd[@]}"
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

case "${1:-}" in
    hosts)      shift; list_hosts "$@" ;;
    status)     shift; do_status "$@" ;;
    containers) shift; do_containers "$@" ;;
    restart)    shift; do_restart "$@" ;;
    -h|--help|"" ) usage ;;
    *) echo "unknown subcommand: $1"; usage ;;
esac