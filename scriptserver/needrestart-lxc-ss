#!/usr/bin/env bash
# ============================================================================
# needrestart-lxc-ss - script-server wrapper for needrestart-lxc.
#
# Installed on the cdist control host as ~cdist/bin/needrestart-lxc-ss (a
# symlink into the needrestart-lxc.git checkout under files.external/) and
# invoked by the script-server runners in /etc/script-server-dev/runners/ as
# `sudo -u cdist -i needrestart-lxc-ss ...`. It reaches the PVE hosts over the
# cdist user's root SSH and runs /usr/local/bin/needrestart-lxc there
# (deployed by cdist, see config/manifest/autorun/zabbix-agent-config).
#
# Subcommands:
#   hosts
#       Print the PVE host FQDNs that have needrestart-lxc deployed (explorer
#       distro == proxmox and a zabbix agent config present), one per line.
#       Used by the runners as their dynamic value list.
#   status [--mode scan|cached] [--all-hosts] HOST [HOST...]
#       Per-host report of containers needing service restarts. With --all-hosts
#       every host that has needrestart-lxc deployed is reported on (the
#       runner's 'All hosts' checkbox); otherwise only the given HOST(s).
#         scan   = run `needrestart-lxc --zabbix` on each host (default;
#                  fresh data incl. CVE analysis, warms the hosts' 24h cache)
#         cached = read the JSON the hosts' 15-min cron writes (instant,
#                  up to 15 minutes old)
#       Output: HTML tables (Services / CVEs / State / Invasive columns).
#       Rows with services to restart deep-link into the "needrestart-lxc"
#       runner with Action=Restart and Restart mode=Restart pre-filled, plus
#       Host and Container.
#   restart --hosts FQDN[,FQDN...] [--targets h1:c1,c2;h2:c3]
#           [--exclude REGEX] [--action dry-run|restart] [--allow-all]
#       Run `needrestart-lxc [-n] -r [-c ID[,ID...]] [-e REGEX]` on one host.
#       dry-run (default) shows what would be restarted; restart actually
#       restarts the flagged services (including the escalation ladder).
#   containers --host FQDN
#       List the containers of one host that currently have services to
#       restart (from the host's cached report), one per line - the value
#       list for the restart runner's dynamic Container multiselect.
# ============================================================================
set -euo pipefail

SSH_OPTS=(-o ConnectTimeout=10 -o BatchMode=yes -o StrictHostKeyChecking=accept-new)
SCAN_TIMEOUT=300          # per-host remote scan timeout, seconds
RESTART_RUNNER="needrestart-lxc"
ACTION_RESTART_UI="Restart flagged services"        # top-level Action option
RESTART_MODE="Restart mode"                          # inner restart parameter name
RESTART_MODE_RESTART_UI="Restart selected services"  # inner Restart mode option

# KEEP IN SYNC: the runner name and the labels above must match the `name`
# field and the values_ui_mapping labels in scriptserver/needrestart-lxc.json
# and scriptserver/include/nrlxc-{status,restart}.json. Deep links must pass
# the mapped UI labels, not the raw script values.

# --- restart output as an html_iframe document ------------------------------
# The runner uses output_format=html_iframe for both actions (the renderer is
# fixed at page load, so an Action change never has to switch it). The status
# report already emits a full HTML document; restart output is plain text, so
# wrap stdout and stderr in a <pre> document and HTML-escape every line -
# otherwise newlines collapse and '<'/'&' in ssh output would be parsed as
# HTML inside the iframe's srcdoc. The head script keeps the view at the tail
# while output streams; the tail script stops that once the run has finished.
HTML_REPORT_HEAD='<!DOCTYPE html><html><head><meta charset="utf-8">'
HTML_REPORT_HEAD+='<style>body{margin:0;font-family:monospace;font-size:.875em}'
HTML_REPORT_HEAD+='pre{white-space:pre-wrap;overflow-wrap:break-word;margin:0;padding:1.5em}</style>'
HTML_REPORT_HEAD+='<script>(function(){var t=setInterval(function(){'
HTML_REPORT_HEAD+='if(window.__nrDone){clearInterval(t);return}'
HTML_REPORT_HEAD+='window.scrollTo(0,document.documentElement.scrollHeight)},250)})()</script>'
HTML_REPORT_HEAD+='</head><body><pre>'
HTML_REPORT_TAIL='<script>window.__nrDone=1</script></pre></body></html>'

# html_escape: HTML-escape stdin line by line (-u keeps the stream live).
html_escape() {
    sed -u -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

# run_html <command> [args...]
# Run <command> with stdout+stderr rendered as an HTML <pre> document; return
# the command's own exit status (PIPESTATUS, ignoring the escaper's status).
run_html() {
    printf '%s' "$HTML_REPORT_HEAD"
    local rc
    set +e
    "$@" 2>&1 | html_escape
    rc=${PIPESTATUS[0]}
    printf '%s' "$HTML_REPORT_TAIL"
    return "$rc"
}

usage() {
    awk 'NR==1{next} /^# ={10,}/{if(n++)exit; next} {sub(/^# ?/,""); print}' "$0"
    exit 1
}

list_hosts() {
    # Hosts where the needrestart-lxc deployment actually applies: the
    # zabbix-agent-config manifest is gated on files/zabbix/agents/<fqdn>
    # (config repo) and the needrestart-lxc block on distro == proxmox
    # (explorer data). Require both so hosts without the binary don't show up
    # as permanent failures in the value list.
    local f
    for f in /home/cdist/explore/*/distro; do
        [[ -r "$f" ]] || continue
        [[ $(<"$f") == proxmox ]] || continue
        local fqdn
        fqdn=$(basename "$(dirname "$f")")
        [[ -f /home/cdist/config/files/zabbix/agents/$fqdn ]] || continue
        echo "$fqdn"
    done
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

# run_on <host> <outfile> <errfile>
# Fresh scan: `needrestart-lxc --zabbix` prints the JSON to stdout and any
# analysis notes to stderr. Cached: the agent UserParameter's file read.
run_on() {
    local host=$1 out=$2 err=$3 cached=${4:-}
    if [[ $cached == cached ]]; then
        timeout $((SCAN_TIMEOUT + 30)) ssh "${SSH_OPTS[@]}" "$host" \
            "cat /var/cache/needrestart-lxc/zabbix.json" \
            >"$out" 2>"$err"
    else
        timeout $((SCAN_TIMEOUT + 30)) ssh "${SSH_OPTS[@]}" "$host" \
            "timeout $SCAN_TIMEOUT /usr/local/bin/needrestart-lxc --zabbix" \
            >"$out" 2>"$err"
    fi
}

do_status() {
    local hosts=()
    local all_hosts=0
    while (($#)); do
        case $1 in
            --mode) [[ -n ${2:-} ]] || { echo "missing argument after $1"; exit 1; }
                    MODE=$2; shift 2 ;;
            --mode=*) MODE=${1#*=}; shift ;;
            --all-hosts) all_hosts=1; shift ;;
            -h|--help) usage ;;
            *) hosts+=("$1"); shift ;;
        esac
    done
    MODE=${MODE:-scan}
    [[ $MODE == scan || $MODE == cached ]] || { echo "bad --mode: $MODE"; exit 1; }
    if [[ $all_hosts == 1 ]]; then
        # 'All hosts' wins over an explicit selection: report on every host
        # with needrestart-lxc deployed (same list the Hosts pulldown uses).
        hosts=()
        local hh
        while IFS= read -r hh; do hosts+=("$hh"); done < <(list_hosts)
    fi
    ((${#hosts[@]})) || { echo "no hosts selected (pick hosts in the pulldown, or tick 'All hosts')" >&2; exit 1; }

    # Global (not local): the EXIT trap below must still see it at script
    # exit, where function locals are out of scope (set -u would abort).
    STATUS_TMP=$(mktemp -d)
    trap 'rm -rf "$STATUS_TMP"' EXIT

    local h pids=()
    for h in "${hosts[@]}"; do
        : >"$STATUS_TMP/$h.json"; : >"$STATUS_TMP/$h.err"; : >"$STATUS_TMP/$h.rc"
        ( if run_on "$h" "$STATUS_TMP/$h.json" "$STATUS_TMP/$h.err" "$MODE"; then
              echo 0 >"$STATUS_TMP/$h.rc"
          else
              echo $? >"$STATUS_TMP/$h.rc"
          fi ) &
        pids+=("$!")
    done
    local rc=0
    for p in "${pids[@]}"; do wait "$p" || rc=1; done

    python3 - "$STATUS_TMP" "$MODE" "$RESTART_RUNNER" "$ACTION_RESTART_UI" \
        "$RESTART_MODE" "$RESTART_MODE_RESTART_UI" <<'PYEOF'
import glob, html, json, os, sys
from datetime import datetime
from urllib.parse import quote

(tmpdir, mode, restart_runner, action_restart_ui,
 restart_mode, restart_mode_restart_ui) = sys.argv[1:7]
runner_enc = quote(restart_runner, safe="")


def qkey(name):
    return quote(name, safe="")


def esc(s):
    return html.escape(str(s), quote=True)


# Deep link into the consolidated runner's restart action. The runner name and
# labels come from the shell constants above and must stay in sync with
# scriptserver/needrestart-lxc.json and include/nrlxc-restart.json. Labels (not
# raw script values) are passed because the UI shows list values through
# values_ui_mapping; the server maps them back to the raw values.
def restart_query(host, cval):
    # repeated query keys: the runner's Hosts and Containers params are
    # multiselects whose prefill expects arrays (comma strings are NOT split).
    # Both Action= (top-level, selects the include) and Restart mode= (inner)
    # are pinned: with any predefinedParameters present, the UI's
    # reloaded-model handler replaces the value state with exactly the
    # deep-link params, so parameters NOT in the link get no value at all (the
    # runner default does NOT apply). The Action param comes first so the
    # restart include (which defines Hosts/Containers/Restart mode) is loaded
    # before those values are applied. With the forceAllowedValues frontend
    # patch (script-server-dev recipe) the forced values are also not wiped
    # while the dependent Containers list is still loading.
    parts = [f"Action={quote(action_restart_ui, safe='')}",
             f"{qkey(restart_mode)}={quote(restart_mode_restart_ui, safe='')}",
             f"Hosts={quote(host, safe='')}",
             f"Containers={quote(host + ':' + cval, safe='')}"]
    return "&amp;".join(parts)


def restart_link(host, cval):
    return f"#/{runner_enc}?{restart_query(host, cval)}"


STATE = {0: ("#1a7f37", "clean"), 1: ("#9a6700", "restart"), 2: ("#cf222e", "CVEs")}


def badge(state):
    color, label = STATE.get(state, ("#6e7781", f"state {state}"))
    return (f'<span style="background:{color};color:#fff;padding:1px 8px;'
            f'border-radius:10px;font-size:smaller">{label}</span>')


# details lines are "svc_display: verdict" (svc_display may carry a
# " (non-systemd)" or " [user session UID n]" suffix); bold the service so
# the lines scan quickly, verdict stays normal.
def fmt_details(raw):
    out = []
    for line in str(raw or "").split("\n"):
        e = esc(line)
        svc, sep, rest = e.partition(": ")
        out.append(f"<b>{svc}</b>: {rest}" if sep else e)
    return "\n".join(out)


# Interactive report (checkboxes + buttons) requires script-server's
# output_format=html_iframe: the plain html format is DOMPurify-sanitized,
# which strips <script>. The runner JSON sets html_iframe; the output is a
# complete HTML document written into the iframe's srcdoc, so a full document
# with <style> and <script> is fine here. The iframe element itself gets the
# .log-content class in the run page (fixed height, own scrollbar), so the
# window no longer grows while chunks stream in and the view stays at the top.
# JS jumps to the parent app's runner via window.top (same-origin srcdoc).
print("<!DOCTYPE html><html><head><meta charset='utf-8'><style>")
print("body{font-family:'Segoe UI',Helvetica,Arial,sans-serif;margin:8px}")
print("table{border-collapse:collapse;font-size:small}")
print("td,th{white-space:nowrap;text-align:left}")
print("td.name{max-width:24ch;overflow:hidden;text-overflow:ellipsis}")
print("td.details{white-space:pre-wrap}")
print("td.sel{text-align:center;width:1%}")
print("span.inv{background:#9a6700;color:#fff;padding:1px 8px;border-radius:10px;")
print("font-size:smaller;white-space:nowrap}")
print("button{padding:2px 10px;font-size:smaller;cursor:pointer}")
print("p.failed{color:#cf222e}")
print("p.notes{font-size:smaller;color:#6e7781}")
print("p.meta{font-size:smaller}")
print("label.all{font-size:smaller;cursor:pointer}")
print("</style><script>")
print(f"var RUNNER = {restart_runner!r};")
print(f"var ACTION_RESTART_UI = {action_restart_ui!r};")
print(f"var RESTART_MODE = {restart_mode!r};")
print(f"var RESTART_MODE_RESTART_UI = {restart_mode_restart_ui!r};")
print("""
function toggleAll(master, hostOnly) {
    var scope = hostOnly ? master.closest('table') : document;
    var boxes = scope.querySelectorAll('input.rsel');
    for (var i = 0; i < boxes.length; i++) boxes[i].checked = master.checked;
}
function goSelected() {
    // collect ticked
    // containers as host-qualified values (host:cval); the restart runner
    // takes repeated Hosts= and Containers= query params
    var hosts = [], containers = [], seen = {};
    var tables = document.querySelectorAll('table[data-host]');
    for (var t = 0; t < tables.length; t++) {
        var host = tables[t].getAttribute('data-host');
        var boxes = tables[t].querySelectorAll('input.rsel:checked');
        for (var i = 0; i < boxes.length; i++) {
            if (!seen[host]) { seen[host] = 1; hosts.push(host); }
            containers.push(host + ':' + boxes[i].value);
        }
    }
    if (!containers.length) { alert('No containers selected.'); return; }
    // Action and Restart mode are pinned (UI-mapped labels): parameters not
    // in the deep link get no value at all, the runner default does NOT apply
    var q = '&Action=' + encodeURIComponent(ACTION_RESTART_UI)
        + '&' + encodeURIComponent(RESTART_MODE) + '='
        + encodeURIComponent(RESTART_MODE_RESTART_UI);
    for (var i = 0; i < hosts.length; i++)
        q += '&Hosts=' + encodeURIComponent(hosts[i]);
    for (var i = 0; i < containers.length; i++)
        q += '&Containers=' + encodeURIComponent(containers[i]);
    window.top.location.hash = '#/' + encodeURIComponent(RUNNER) + '?' + q;
}
</script></head><body>""")
CONTROLS = ("<label class=all title='tick to select/deselect every container on every host'>"
            "<input type=checkbox onchange=\"toggleAll(this)\"> all</label> &nbsp; "
            "<button onclick='goSelected()' "
            "title='open the restart runner with all ticked containers (across hosts); "
            "Action preselected to restart'>"
            "go to restart</button>")
print(f"<p class=meta>mode: {esc(mode)} &mdash; generated {esc(datetime.now().strftime('%Y-%m-%d %H:%M:%S'))} "
      f"&nbsp; {CONTROLS}</p>")

total_svc = total_cve = 0
files = sorted(glob.glob(os.path.join(tmpdir, "*.json")))
for path in files:
    host = os.path.basename(path)[:-len(".json")]
    err = open(path[:-len("json")] + "err").read().strip()
    rc = open(path[:-len("json")] + "rc").read().strip()
    try:
        containers = json.load(open(path)).get("containers", [])
    except ValueError:
        containers = None

    if containers is None:
        print(f"<h3>{esc(host)}</h3>")
        print(f'<p class=failed><b>failed</b> (rc {esc(rc)}):'
              f"<pre>{esc(err[-2000:]) or 'no output'}</pre></p>")
        continue

    # CVE-affected first, then plain restarts, clean last; CTID order within
    # each group (stable sort on ctid).
    containers = sorted(
        containers,
        key=lambda c: (-c.get("state", 0),
                       int(c["ctid"]) if str(c.get("ctid", "")).isdigit() else 0))
    flagged = [c for c in containers if c.get("services", 0) > 0]
    total_svc += sum(c["services"] for c in flagged)
    total_cve += sum(c.get("cves", 0) for c in flagged)
    print(f"<h3>{esc(host)}</h3>")
    print(f'<p class=meta>{len(flagged)} of {len(containers)} '
          f"container(s) need a restart</p>")
    print(f'<table border=1 cellpadding=4 cellspacing=0 data-host="{esc(host)}">')
    th = "<th>"
    print(f"<tr><th title='tick to select/deselect all containers of this host'>"
          f"<input type=checkbox onchange=\"toggleAll(this, true)\"></th>{th}CT</th>{th}Name</th>"
          f"{th}Services</th>{th}CVEs</th>{th}State</th>"
          f"<th title='services needrestart would defer restarting as potentially invasive'>"
          f"Invasive</th>{th}Details</th></tr>")
    # Deep links must prefill the restart runner's Container multiselect, whose
    # values are the container name (unique) or the CTID (ambigous/unknown 
    # names) - same rule as the `containers` subcommand.
    all_names = [c.get("name") for c in containers]
    for c in containers:
        svc, cves = c.get("services", 0), c.get("cves", 0)
        if svc == 0:
            continue  # clean containers: no findings, not shown
        details = fmt_details(c.get("details"))
        ct = esc(c.get("ctid", "?"))
        if svc > 0:
            cname = c.get("name")
            cval = (cname if cname and cname != "unknown"
                    and all_names.count(cname) == 1 else c.get("ctid", ""))
            href = restart_link(host, cval)
            ct = (f'<a target="_top" href="{href}" '
                  f'title="open restart runner">{ct}</a>')
            sel = f'<input type=checkbox class=rsel value="{esc(cval)}">'
        else:
            sel = ""
        name = esc(c.get("name", "?"))
        inv = c.get("invasive", 0) or 0
        inv_names = ", ".join(c.get("invasive_services") or [])
        inv_cell = (f'<span class=inv title="{esc(inv_names)}">'
                    f'&#9888; {inv} deferred</span>') if inv else ""
        print(f'<tr><td class=sel>{sel}</td><td>{ct}</td>'
              f'<td class=name title="{name}">{name}</td>'
              f"<td style='text-align:right'>{svc}</td>"
              f"<td style='text-align:right'>{cves}</td>"
              f"<td>{badge(c.get('state', 0))}</td>"
              f"<td>{inv_cell}</td>"
              f"<td class=details>{details}</td></tr>")
    print("</table>")
    if err:
        print(f'<p class=notes>notes:'
              f"<pre style='margin:2px'>{esc(err[-2000:])}</pre></p>")

print(f"<hr><p><b>Totals:</b> {total_svc} service(s), {total_cve} CVE(s) "
      f"across {len(files)} host(s).</p>")
print(f"<p>{CONTROLS}</p>")
print("</body></html>")
PYEOF
    return $rc
}

# ---------------------------------------------------------------------------
# restart
# ---------------------------------------------------------------------------

# shquote <string>
# POSIX-safe single-quoted form for embedding into a remote shell command.
# ssh re-joins argv into one string and runs it through the remote login
# shell, so unquoted user input from the script-server UI would be
# interpreted there (as root on the PVE host).
shquote() {
    local s=${1//\'/\'\\\'\'}
    printf "'%s'" "$s"
}

do_containers() {
    # script-server splits the rendered values-script command with shlex
    # (shell=false), which eats the quotes, so ${Hosts} arrives as word
    # fragments: --hosts [h1, h2] -> tokens "[h1," "h2]". Collect all
    # non-flag tokens, strip the list-repr artifacts, re-validate.
    local -a raw=()
    while (($#)); do
        case $1 in
            --host|--hosts) shift ;;
            -h|--help) usage ;;
            *) raw+=("$1"); shift ;;
        esac
    done
    ((${#raw[@]})) || { echo "--hosts is required" >&2; exit 1; }
    local hostspec
    hostspec=$(printf '%s' "${raw[*]}" | tr -d "[]'\" ")
    [[ $hostspec =~ ^[A-Za-z0-9.-]+(,[A-Za-z0-9.-]+)*$ ]] \
        || { echo "bad --hosts format (expected host[,host...]): got '$hostspec'" >&2; exit 1; }

    # Read the hosts' cached reports (instant; the restart run itself rescans
    # fresh, so staleness only affects what the checkbox list offers) and emit
    # one line per container that has services to restart, as
    # "host:container" (host-qualified so containers on different hosts
    # cannot collide). The line IS a --targets token, so the container
    # must resolve to exactly one target: use the container name when
    # unique, else the CTID.
    local out err rc h
    out=$(mktemp); err=$(mktemp)
    local -a hostlist
    IFS=',' read -ra hostlist <<< "$hostspec"
    for h in "${hostlist[@]}"; do
        run_on "$h" "$out" "$err" cached \
            || { echo "failed to read cached report from $h (rc $?)" >&2; rm -f "$out" "$err"; exit 1; }
        python3 - "$out" "$h" <<'PYEOF'
import json, sys

data = json.load(open(sys.argv[1]))
containers = [c for c in data.get("containers", []) if c.get("services", 0) > 0]
names = [c.get("name") for c in containers]
containers.sort(key=lambda c: (-c.get("state", 0),
                               int(c["ctid"]) if str(c.get("ctid", "")).isdigit() else 0))
for c in containers:
    name = c.get("name")
    val = name if name and name != "unknown" and names.count(name) == 1 \
        else str(c.get("ctid", "?"))
    print(f"{sys.argv[2]}:{val}")
PYEOF
    done
    rm -f "$out" "$err"
}

do_restart() {
    # One entry point for all restarts; hosts and container lists are
    # restricted to hostname-ish characters (they end up as ssh destination /
    # shquoted remote args); anything else is rejected, never passed on.
    #   --hosts h1,h2            run on these host(s)
    #   --targets h1:c1,c2;h2:c3  (from the list report; ':' grouping also
    #                             accepted as ','-separated host:c pairs)
    #   --exclude RE, --action dry-run|restart
    #   --allow-all     permit restarting ALL flagged containers when no
    #                   targets are given (safety: without it, a real restart
    #                   with an empty container selection is refused)
    # Runs execute sequentially in one HTML log, one scan per host; exit code
    # is non-zero if any host failed.
    local hostspec="" targets="" exclude="" action="dry-run" allow_all=0
    while (($#)); do
        case $1 in
            --host|--hosts) [[ -n ${2:-} ]] || { echo "missing argument after $1"; exit 1; }
                    hostspec=$2; shift 2 ;;
            --targets) [[ -n ${2:-} ]] || { echo "missing argument after $1"; exit 1; }
                    targets=$2; shift 2 ;;
            --exclude) [[ -n ${2:-} ]] || { echo "missing argument after $1"; exit 1; }
                    exclude=$2; shift 2 ;;
            --action) [[ -n ${2:-} ]] || { echo "missing argument after $1"; exit 1; }
                    action=$2; shift 2 ;;
            --allow-all) allow_all=1; shift ;;
            -h|--help) usage ;;
            *) echo "unknown restart option: $1"; exit 1 ;;
        esac
    done
    [[ -n $hostspec || -n $targets ]] || { echo "--hosts or --targets is required"; exit 1; }
    [[ $action == dry-run || $action == restart ]] || { echo "bad --action: $action"; exit 1; }

    # Build the ordered per-host grouping: hosts_list + groups[host]=csv
    local -A groups=()
    local -a hostlist=()
    if [[ -n ${targets:-} ]]; then
        [[ $targets =~ ^[A-Za-z0-9.-]+:[A-Za-z0-9._-]+(,[A-Za-z0-9.-]+:[A-Za-z0-9._-]+)*$ ]] \
            || { echo "bad --targets format (expected comma-separated host:container pairs)"; exit 1; }
        local -a toks
        local tok h cv
        IFS=',' read -ra toks <<< "$targets"
        for tok in "${toks[@]}"; do
            h=${tok%%:*}
            cv=${tok#*:}
            if [[ -z ${groups[$h]+x} ]]; then
                hostlist+=("$h")
                groups[$h]=$cv
            else
                [[ ,${groups[$h]}, == *,$cv,* ]] || groups[$h]+=",$cv"
            fi
        done
    else
        [[ $hostspec =~ ^[A-Za-z0-9.-]+(,[A-Za-z0-9.-]+)*$ ]] \
            || { echo "bad --hosts format (expected host[,host...])"; exit 1; }
        IFS=',' read -ra hostlist <<< "$hostspec"
        for h in "${hostlist[@]}"; do groups[$h]=""; done
    fi

    # Safety: an empty Containers selection means "ALL flagged containers on
    # every selected host". That is far too easy to hit by accident (a dropped
    # prefill once restarted everything on a host, killing user sessions), so
    # a real restart without explicit targets requires --allow-all; dry-run
    # still previews everything.
    if [[ $action == restart && $allow_all != 1 ]]; then
        local hh has_targets=0
        for hh in "${hostlist[@]}"; do
            if [[ -n ${groups[$hh]} ]]; then has_targets=1; fi
        done
        if [[ $has_targets == 0 ]]; then
            echo "refusing to restart ALL flagged containers: no containers selected" >&2
            echo "(tick containers, or tick 'Allow all' in the UI / pass --allow-all)" >&2
            exit 1
        fi
    fi

    local rc=0 h csv remote
    for h in "${hostlist[@]}"; do
        csv=${groups[$h]}
        remote="/usr/local/bin/needrestart-lxc"
        [[ $action == dry-run ]] && remote+=" -n"
        remote+=" -r"
        [[ -n $csv ]] && remote+=" -c $(shquote "$csv")"
        [[ -n $exclude ]] && remote+=" -e $(shquote "$exclude")"
        echo "=== $h ==="
        if ! ssh "${SSH_OPTS[@]}" "$h" -- "$remote"; then
            rc=1
        fi
    done
    [[ $rc == 0 ]] && echo "all hosts ok" || echo "SOME HOSTS FAILED"
    return $rc
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

case "${1:-}" in
    hosts)      shift; list_hosts "$@" ;;
    status)     shift; do_status "$@" ;;
    containers) shift; do_containers "$@" ;;
    restart)    shift; run_html do_restart "$@" ;;
    -h|--help|"" ) usage ;;
    *) echo "unknown subcommand: $1"; usage ;;
esac
