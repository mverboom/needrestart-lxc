#!/usr/bin/env bash
# ============================================================================
# hosts-cdist-explore - reference host-list command for the needrestart
# runners, for sites that manage their hosts with cdist.
#
# The wrappers do not know any host names: they ask the site by running
# `needrestart-ss-hosts <tool>` and use its stdout as the Hosts value list
# (see README.md, "Host lists"). This file is one implementation of that
# contract. Install it under that name somewhere on the PATH the wrapper runs
# with, e.g.:
#
#   ln -sfn /path/to/needrestart-lxc.git/scriptserver/hosts-cdist-explore \
#           /home/cdist/bin/needrestart-ss-hosts
#
# Usage: hosts-cdist-explore needrestart|needrestart-lxc
#        Prints the FQDNs to report on, one per line, on stdout.
#
# Environment:
#   EXPLORE_DIR        cdist explorer directory (default /home/cdist/explore)
#   ZABBIX_AGENTS_DIR  the zabbix-agent-config gate: only PVE hosts with this
#                      directory entry are monitored, and that manifest is
#                      what deploys needrestart-lxc. Set it empty to drop the
#                      requirement and report on every PVE host.
#                      (default /home/cdist/config/files/zabbix/agents)
# ============================================================================
set -u

EXPLORE_DIR=${EXPLORE_DIR:-/home/cdist/explore}
ZABBIX_AGENTS_DIR=${ZABBIX_AGENTS_DIR-/home/cdist/config/files/zabbix/agents}

usage() {
   awk 'NR==1{next} /^# ={10,}/{if(n++)exit; next} {sub(/^# ?/,""); print}' "$0"
   exit 1
}

# print the FQDNs of the explorer host directories matching a predicate
filter_hosts() {
   local predicate=$1 dir
   for dir in "${EXPLORE_DIR}"/*/; do
      [[ -d "$dir" ]] || continue
      dir=${dir%/}
      "$predicate" "$dir" || continue
      printf '%s\n' "${dir##*/}"
   done
}

# predicate: the host's explorer package list contains needrestart
has_needrestart_package() {
   local packages=${1}/packages
   [[ -r "$packages" ]] || return 1
   grep --quiet '^needrestart ' "$packages"
}

# predicate: PVE host, and (unless the gate is disabled) zabbix-agent managed
is_managed_pve_host() {
   local host_dir=$1 distro=${1}/distro
   [[ -r "$distro" ]] || return 1
   [[ $(<"$distro") == proxmox ]] || return 1
   [[ -z "$ZABBIX_AGENTS_DIR" ]] && return 0
   [[ -f "${ZABBIX_AGENTS_DIR}/${host_dir##*/}" ]]
}

# list the hosts the needrestart (host level) runner reports on
list_needrestart() {
   filter_hosts has_needrestart_package
}

# list the hosts the needrestart-lxc runner reports on
list_needrestart_lxc() {
   filter_hosts is_managed_pve_host
}

main() {
   local tool=${1:-}
   if [[ ! -d "$EXPLORE_DIR" ]]; then
      printf 'explorer directory not found: %s (set EXPLORE_DIR)\n' \
         "$EXPLORE_DIR" >&2
      return 1
   fi
   case $tool in
      needrestart) list_needrestart ;;
      needrestart-lxc) list_needrestart_lxc ;;
      *) usage ;;
   esac
}

main "$@"
