def ct_root(ctid):
    return f"/proc/{CT_PIDS[ctid]}/root"


def load_ct_os(ctid, root):
    osr = os.path.join(root, "etc/os-release")
    if not os.path.isfile(osr):
        return False
    for line in open(osr, errors="ignore"):
        line = line.strip()
        if not line or "=" not in line:
            continue
        k, v = line.split("=", 1)
        v = v.strip('"')
        if k == "ID":
            CT_OS_ID[ctid] = v
        elif k == "VERSION_ID":
            CT_OS_RELEASE[ctid] = v
        elif k == "VERSION_CODENAME":
            CT_OS_CODENAME[ctid] = v
    return ctid in CT_OS_ID


def parse_dpkg_status(ctid, root):
    out = os.path.join(WORKDIR, f"status-{ctid}.tsv")
    if os.path.isfile(out):
        return True
    st = os.path.join(root, "var/lib/dpkg/status")
    if not os.path.isfile(st):
        return False
    rows = []
    pkg = ver = src = status = ""
    for line in open(st, errors="ignore"):
        if line.startswith("Package: "):
            pkg = line[len("Package: "):].strip()
        elif line.startswith("Version: "):
            ver = line[len("Version: "):].strip()
        elif line.startswith("Source: "):
            src = line[len("Source: "):].strip().split()[0] if line[len("Source: "):].strip() else ""
        elif line.startswith("Status: "):
            status = line[len("Status: "):].strip()
        elif line == "\n":
            if pkg and status.startswith("install"):
                rows.append(f"{pkg}\t{ver}\t{src}")
            pkg = ver = src = status = ""
    with open(out, "w") as fh:
        fh.write("\n".join(rows) + ("\n" if rows else ""))
    return True


def status_lookup(ctid, binpkg):
    f = os.path.join(WORKDIR, f"status-{ctid}.tsv")
    try:
        for line in open(f):
            p, v, s = line.rstrip("\n").split("\t")
            if p == binpkg:
                return f"{v}\t{s}"
    except (OSError, ValueError):
        pass
    return ""


def pkgs_for_path(root, path):
    if not re.match(r"^/[A-Za-z0-9._+~/-]+$", path):
        return []
    pkgs = set()
    for list_file in glob.glob(root + "/var/lib/dpkg/info/*.list"):
        if not os.path.isfile(list_file):
            continue
        try:
            with open(list_file, errors="ignore") as fh:
                lines = set(fh.read().splitlines())
        except OSError:
            continue
        if path in lines:
            base = os.path.basename(list_file)[:-len(".list")]
            pkgs.add(base.split(":")[0])
    return sorted(pkgs)


def ver_cmp(a, b):
    """Debian version comparison; returns -1, 0 or 1 (dpkg semantics)."""
    if subprocess.run(["dpkg", "--compare-versions", a, "eq", b],
                      capture_output=True).returncode == 0:
        return 0
    if subprocess.run(["dpkg", "--compare-versions", a, "gt", b],
                      capture_output=True).returncode == 0:
        return 1
    return -1


def epoch_from_date(datestr, tz):
    cmd = ["date", "-d", datestr, "+%s"]
    env = dict(os.environ)
    if tz:
        env["TZ"] = tz
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=10)
        if r.returncode == 0 and r.stdout.strip().isdigit():
            return int(r.stdout.strip())
    except Exception:
        pass
    return None


def version_at_start(root, binpkg, start_epoch):
    """Determine the package version in effect when a process started, by
    matching dpkg.log upgrade/install timestamps against the process start."""
    all_data = ""
    for f in sorted(glob.glob(root + "/var/log/dpkg.log*")):
        if not os.path.isfile(f):
            continue
        try:
            if f.endswith(".gz"):
                with gzip.open(f, "rt", errors="ignore") as fh:
                    all_data += fh.read() + "\n"
            else:
                with open(f, "r", errors="ignore") as fh:
                    all_data += fh.read() + "\n"
        except OSError:
            pass
    if not all_data:
        return ""

    tz = ""
    try:
        tz = re.sub(r"[\s]", "", open(root + "/etc/timezone").read())
    except OSError:
        pass

    best = ""
    best_ts = 0
    for line in all_data.splitlines():
        parts = line.split()
        if len(parts) < 5 or parts[2] not in ("upgrade", "install"):
            continue
        p = parts[3].split(":")[0]
        if p != binpkg:
            continue
        if parts[2] == "upgrade" and len(parts) >= 6:
            v = parts[5]
        else:
            v = parts[4]
        if not v:
            continue
        ts = epoch_from_date(line[:19], tz)
        if ts is None:
            continue
        if ts <= start_epoch and ts >= best_ts:
            best_ts = ts
            best = v
    return best


def parse_changelog(path):
    """Yield ("ENTRY", version, suite) and ("BODY", text) tuples."""
    fh = gzip.open(path, "rt", errors="ignore") if path.endswith(".gz") else open(path, "r", errors="ignore")
    with fh:
        for line in fh:
            line = line.rstrip("\n")
            if re.match(r"^[A-Za-z0-9.+~_-]+ \([^)]+\) [^;]+; urgency=", line):
                version = re.sub(r"\)[^)]*", "", re.sub(r"^[^ ]+ \(", "", line))
                suite = re.sub(r";.*", "", re.sub(r"^[^ ]+ \([^)]+\) ", "", line))
                yield ("ENTRY", version, suite)
            elif line.startswith("-- "):
                continue
            else:
                yield ("BODY", line)


def changelog_verdict(root, binpkg, srcpkg, old, new):
    """Offline verdict from the package changelog: count CVE references in the
    entries between old and new versions. If old is empty, only the newest
    entry is considered. Returns "count<TAB>verdict" or "" if no changelog."""
    file = None
    for docpkg in (binpkg, srcpkg):
        for cand in (
            f"{root}/usr/share/doc/{docpkg}/changelog.Debian.gz",
            f"{root}/usr/share/doc/{docpkg}/changelog.Debian",
            f"{root}/usr/share/doc/{docpkg}/changelog.gz",
            f"{root}/usr/share/doc/{docpkg}/changelog",
        ):
            if os.path.isfile(cand):
                file = cand
                break
        if file:
            break
    if not file:
        return ""

    cves = set()
    sec_count = 0
    want_entry = False
    top_entry = False
    for kind, *fields in parse_changelog(file):
        if kind == "ENTRY":
            if top_entry:
                break
            version, suite = fields
            want_entry = False
            if old:
                if ver_cmp(version, old) > 0 and ver_cmp(version, new) <= 0:
                    want_entry = True
            else:
                want_entry = True
                top_entry = True
            if want_entry and ("-security" in suite or "-updates" in suite):
                sec_count += 1
        elif kind == "BODY" and want_entry:
            for cve in re.findall(r"CVE-\d{4}-\d+", fields[0]):
                cves.add(cve)

    cves = sorted(cves)
    n = len(cves)
    shown = 0
    shown_list = []
    for cve in cves:
        if shown < 6:
            shown_list.append(cve)
        shown += 1
    cvelist = ", ".join(shown_list)
    if shown > 6:
        cvelist += f", and {shown - 6} more"
    plural = "" if n == 1 else "s"
    secpart = ", security upload" if sec_count > 0 else ""

    if old:
        if n > 0:
            return f"{n}\t{binpkg} {old} -> {new}: fixes {n} CVE{plural} ({cvelist}){secpart} [changelog]"
        return f"{n}\t{binpkg} {old} -> {new}: no CVEs listed in changelog for this update [changelog]"
    else:
        if n > 0:
            return f"{n}\t{binpkg} -> {new} (old version unknown): latest changelog entry lists {n} CVE{plural} ({cvelist}){secpart} [changelog]"
        return f"{n}\t{binpkg} -> {new} (old version unknown): latest changelog entry lists no CVEs [changelog]"


def clean_lib_path(p):
    for suf in (" (executable)", " (inode mismatch)", " (deleted)"):
        if p.endswith(suf):
            p = p[:-len(suf)]
    return p


def osv_collect(srcpkg, version, release):
    """Query (cached) the OSV API for a Debian package version; returns a list
    of "CVE-ID<TAB>fixed-version" lines, or None on network failure."""
    version = re.sub(r"\+b\d+$", "", version)
    cache_name = re.sub(r"[^A-Za-z0-9._-]", "_", f"{release}-{srcpkg}-{version}")
    cache = os.path.join(CACHE_DIR, f"osv-{cache_name}.json")

    data = load_cache(cache)
    if data is None:
        body = json.dumps({"package": {"name": srcpkg, "ecosystem": "Debian"},
                           "version": version}).encode()
        try:
            req = urllib.request.Request(
                "https://api.osv.dev/v1/query", data=body,
                headers={"Content-Type": "application/json",
                         "User-Agent": "needrestart-lxc"})
            with urllib.request.urlopen(req, timeout=30) as resp:
                data = json.load(resp)
        except Exception:
            return None
        write_cache(cache, data)

    out = []
    for vuln in data.get("vulns", []):
        fixed = None
        for affected in vuln.get("affected", []):
            package = affected.get("package", {})
            if package.get("name") != srcpkg:
                continue
            ecosystem = package.get("ecosystem", "")
            if ecosystem != release and not ecosystem.startswith(release + ":"):
                continue
            for rng in affected.get("ranges", []):
                if rng.get("type") != "ECOSYSTEM":
                    continue
                for event in rng.get("events", []):
                    if event.get("fixed") not in (None, "", "0"):
                        fixed = event["fixed"]
        if fixed:
            cve = (vuln.get("upstream") or [vuln.get("id", "")])[0]
            out.append(f"{cve}\t{fixed}")
    return out


def ubuntu_collect(srcpkg, codename):
    """Query (cached) the Ubuntu Security API for all CVEs of a source package;
    returns a list of "CVE-ID<TAB>fixed-version<TAB>cvss3" lines, or None on
    network failure."""
    cache_name = re.sub(r"[^A-Za-z0-9._-]", "_", f"ubuntu-{srcpkg}")
    cache = os.path.join(CACHE_DIR, f"{cache_name}.json")

    data = load_cache(cache)
    if data is None:
        try:
            data = fetch_all_ubuntu(srcpkg, cache)
        except Exception:
            return None

    out = []
    for cve in data.get("cves", []):
        for entry in cve.get("packages", []):
            if entry.get("name") != srcpkg:
                continue
            for status in entry.get("statuses", []):
                if status.get("release_codename") != codename:
                    continue
                if status.get("status") != "released":
                    continue
                fixed = (status.get("description") or "").strip()
                if not fixed:
                    continue
                out.append(f"{cve.get('id', '')}\t{fixed}\t{cve.get('cvss3') or ''}")
                break
    return out


def fetch_all_ubuntu(pkg, cache):
    BASE = "https://ubuntu.com/security/cves.json"
    PAGE = 20          # max accepted by the API
    PAGE_SLEEP = 2.0   # be gentle; the API rate-limits bursts (429)
    MAX_PAGES = 100
    merged = []
    offset = 0
    total = 1
    pages = 0
    while offset < total and pages < MAX_PAGES:
        url = f"{BASE}?package={pkg}&limit={PAGE}&offset={offset}"
        data = None
        for attempt in range(3):
            try:
                req = urllib.request.Request(url, headers={"User-Agent": "needrestart-lxc"})
                with urllib.request.urlopen(req, timeout=30) as resp:
                    data = json.load(resp)
                break
            except urllib.error.HTTPError as err:
                if err.code == 429 and attempt < 2:
                    time.sleep(60)
                    continue
                raise
        if data is None:
            raise RuntimeError("no response")
        cves = data.get("cves", [])
        merged.extend(cves)
        total = data.get("total_results", 0) or len(merged)
        if len(cves) < PAGE:
            break
        offset += PAGE
        pages += 1
        time.sleep(PAGE_SLEEP)
    write_cache(cache, {"cves": merged, "total_results": total})
    return {"cves": merged, "total_results": total}


def load_cache(cache):
    if os.path.isfile(cache) and time.time() - os.path.getmtime(cache) < CACHE_TTL:
        try:
            with open(cache) as fh:
                return json.load(fh)
        except (OSError, ValueError):
            pass
    return None


def write_cache(cache, data):
    tmp = cache + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh)
    os.replace(tmp, cache)


def security_analysis(ctid, srcpkg, binpkg, old, new):
    """Produce the security verdict for one source package update; results are
    cached in EXT_VERDICTS so shared libraries in the same container are only
    analyzed once. Returns "count<TAB>verdict"."""
    verdict_key = f"{ctid}|{srcpkg}|{old}|{new}"
    if verdict_key in EXT_VERDICTS:
        return EXT_VERDICTS[verdict_key]

    root = ct_root(ctid)
    count = 0
    verdict = ""

    if not old:
        result = changelog_verdict(root, binpkg, srcpkg, "", new)
        if result:
            count, verdict = result.split("\t", 1)
        else:
            verdict = f"{binpkg} -> {new} (old version unknown): no changelog available"
            CT_CVE_UNKNOWN.add(ctid)
    elif ver_cmp(old, new) >= 0:
        verdict = f"{binpkg} {old} -> {new}: no version change since process start"
    else:
        online_ok = False
        src_label = ""
        rows = []
        distro = CT_OS_ID.get(ctid)
        if distro == "debian" and CT_OS_RELEASE.get(ctid):
            res = osv_collect(srcpkg, old, f"Debian:{CT_OS_RELEASE[ctid]}")
            if res is not None:
                online_ok, src_label, rows = True, "OSV", res
        elif distro == "ubuntu" and CT_OS_CODENAME.get(ctid):
            res = ubuntu_collect(srcpkg, CT_OS_CODENAME[ctid])
            if res is not None:
                online_ok, src_label, rows = True, "Ubuntu Security API", res

        if online_ok:
            count = 0
            cves = []
            cvss_list = []
            seen = set()
            for row in rows:
                parts = row.split("\t")
                if len(parts) < 2:
                    continue
                cve_id, fixed = parts[0], parts[1]
                cvss3 = parts[2] if len(parts) > 2 else ""
                if not cve_id or not fixed:
                    continue
                if not (ver_cmp(old, fixed) < 0 and ver_cmp(fixed, new) <= 0):
                    continue
                if cve_id in seen:
                    continue
                seen.add(cve_id)
                count += 1
                cves.append(cve_id)
                if cvss3:
                    cvss_list.append(cvss3)
            if count > 0:
                shown = 0
                shown_list = []
                for cve in cves:
                    if shown < 6:
                        shown_list.append(cve)
                    shown += 1
                cvelist = ", ".join(shown_list)
                if shown > 6:
                    cvelist += f", and {shown - 6} more"
                plural = "" if count == 1 else "s"
                cvss = f", CVSS {','.join(cvss_list)}" if cvss_list else ""
                verdict = (f"{binpkg} {old} -> {new}: SECURITY update, fixes "
                           f"{count} CVE{plural} ({cvelist}{cvss}) [{src_label}]")
            else:
                verdict = (f"{binpkg} {old} -> {new}: no security-relevant CVEs "
                           f"found [{src_label}]")
        else:
            result = changelog_verdict(root, binpkg, srcpkg, old, new)
            if result:
                count, verdict = result.split("\t", 1)
            else:
                verdict = f"{binpkg} {old} -> {new}: security data unavailable (offline?)"
                CT_CVE_UNKNOWN.add(ctid)

    EXT_VERDICTS[verdict_key] = f"{count}\t{verdict}"
    return EXT_VERDICTS[verdict_key]


def analyze_service_libs(ctid, key, root, start_epoch, libs):
    binpkgs = []
    seen_pkgs = set()
    for line in libs.split("\n"):
        if not line:
            continue
        path = clean_lib_path(line)
        for bp in pkgs_for_path(root, path):
            if bp not in seen_pkgs:
                seen_pkgs.add(bp)
                binpkgs.append(bp)

    if not binpkgs:
        CONT_CVES[key] = "no owning dpkg package found for stale libraries"
        CT_CVE_UNKNOWN.add(ctid)
        return

    seen_verdicts = set()
    for binpkg in binpkgs:
        status_out = status_lookup(ctid, binpkg)
        if not status_out:
            CONT_CVES[key] = (CONT_CVES.get(key, "") +
                              ("\n" if CONT_CVES.get(key) else "") +
                              f"no dpkg status entry for {binpkg}")
            CT_CVE_UNKNOWN.add(ctid)
            continue
        curver, srcpkg = status_out.split("\t", 1)
        if not srcpkg:
            srcpkg = binpkg

        old = ""
        if start_epoch:
            old = version_at_start(root, binpkg, start_epoch)

        # Skip if this exact update was already analyzed for this service
        # (e.g. libssl3 and openssl both belong to the openssl source package)
        vkey = f"{ctid}|{srcpkg}|{old}|{curver}"
        if vkey in seen_verdicts:
            continue
        seen_verdicts.add(vkey)

        result = security_analysis(ctid, srcpkg, binpkg, old, curver)
        count, verdict = result.split("\t", 1)
        if not re.match(r"^\d+$", count):
            count = "0"
        CONT_UPDATE_COUNTS[vkey] = int(count)
        CONT_CVES[key] = (CONT_CVES.get(key, "") +
                          ("\n" if CONT_CVES.get(key) else "") + verdict)
        CONT_CVE_COUNTS[key] = CONT_CVE_COUNTS.get(key, 0) + int(count)


def security_scan():
    for key in sorted(CONT_SERVICES):
        ctid = key.split(":", 1)[0]
        pid = CONT_PID.get(key)
        if not pid:
            continue
        root = ct_root(ctid)
        if not os.path.isdir(root):
            continue

        if ctid not in CT_OS_ID:
            if not load_ct_os(ctid, root):
                CT_NOTES[ctid] = "no /etc/os-release found in container"
                continue
        distro = CT_OS_ID.get(ctid)
        if distro not in ("debian", "ubuntu"):
            CT_NOTES[ctid] = f"CVE analysis not supported for distro {distro}"
            continue
        if not parse_dpkg_status(ctid, root):
            CT_NOTES[ctid] = "no dpkg database found in container"
            continue

        lstart = subprocess.run(["ps", "-o", "lstart=", "-p", pid],
                                capture_output=True, text=True).stdout.strip()
        start_epoch = ""
        if lstart:
            r = subprocess.run(["date", "-d", lstart, "+%s"],
                               capture_output=True, text=True)
            if r.returncode == 0 and r.stdout.strip().isdigit():
                start_epoch = int(r.stdout.strip())

        log_verbose(f"Extended security analysis for CT {ctid}, "
                    f"service {key.split(':', 1)[1]} (PID {pid})...")
        analyze_service_libs(ctid, key, root, start_epoch, CONT_SERVICES[key])

    for ctid in sorted(CT_NOTES):
        msg = f"Container {ctid} ({CT_NAMES.get(ctid, 'unknown')}): {CT_NOTES[ctid]}"
        if ZABBIX:
            print(msg, file=sys.stderr)
        else:
            print(msg)


def zabbix_output():
    containers = {}
    sorted_keys = sorted(CONT_SERVICES)
    for ctid in sorted(CT_PIDS, key=int):
        services = 0
        cves = 0
        details = []
        for key in sorted_keys:
            if not key.startswith(ctid + ":"):
                continue
            services += 1
            _rest = key.split(":", 1)[1]
            user_uid, service = _rest.split(":", 1)
            if key in NON_SYSTEMD_KEYS:
                svc_display = f"{service} (non-systemd)"
            else:
                svc_display = f"{service} [user session UID {user_uid}]" if user_uid else service
            if key in CONT_CVES:
                for vl in CONT_CVES[key].split("\n"):
                    if not vl:
                        continue
                    details.append(f"{svc_display}: {vl}")
            else:
                details.append(f"{svc_display}: needs restart")
        # CVEs are counted once per update, not once per affected service
        for ukey, uc in CONT_UPDATE_COUNTS.items():
            if ukey.startswith(ctid + "|"):
                cves += uc
        containers[ctid] = {
            "ctid": ctid,
            "name": CT_NAMES.get(ctid, "unknown"),
            "services": services,
            "cves": cves,
            "cves_ok": 0 if ctid in CT_CVE_UNKNOWN else 1,
            "details": "\n".join(details),
        }

    out_containers = [containers[k] for k in sorted(containers, key=int)]
    needing = [c for c in out_containers if c["services"] > 0]
    total_services = sum(c["services"] for c in needing)
    total_cves = sum(c["cves"] for c in needing)
    if needing:
        lines = [f"- {c['name']}: {c['services']} services, {c['cves']} CVEs"
                 for c in needing]
        summary_text = (
            f"{len(needing)} container(s) need restart "
            f"({total_services} services, {total_cves} CVEs):\n"
            + "\n".join(lines)
        )
    else:
        summary_text = "No containers need a restart."
    out = {
        "containers": out_containers,
        "summary": {
            "needing_restart": len(needing),
            "total_services": total_services,
            "cves": total_cves,
            "text": summary_text,
        },
    }
    text = json.dumps(out)

    # Publish to the cache file the Zabbix agent reads, atomically, creating
    # the dir if needed (so cron needs no redirect). On failure the previous
    # cache file is left untouched.
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        target = os.path.join(CACHE_DIR, "zabbix.json")
        tmp = target + ".tmp"
        with open(tmp, "w") as fh:
            fh.write(text)
        os.replace(tmp, target)
        os.chmod(target, 0o644)
    except OSError:
        return 1

    print(text)
    return 0


def _run():
    global WORKDIR
    if SECURITY:
        WORKDIR = tempfile.mkdtemp(prefix="needrestart-lxc.")
        os.makedirs(CACHE_DIR, exist_ok=True)

    load_container_names()
    if resolve_container_filter():
        return 1
    get_container_pids()
    scan_containers()

    if SECURITY:
        security_scan()

    if MODE == "restart":
        restart_services()
    elif MODE == "zabbix":
        return zabbix_output()
    else:
        print_results()
    return 0


def main(argv):
    global MODE, VERBOSE, DEEP, DRY_RUN, SECURITY, ZABBIX, CONTAINER_FILTER
    args_valid = True
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-l", "--list"):
            MODE = "list"; i += 1
        elif a in ("-r", "--restart"):
            MODE = "restart"; i += 1
        elif a in ("-n", "--dry-run"):
            DRY_RUN = 1; i += 1
        elif a in ("-c", "--container"):
            CONTAINER_FILTER = argv[i + 1] if i + 1 < len(argv) else ""
            i += 2
        elif a in ("-e", "--exclude"):
            EXCLUDE_PATTERNS.append(argv[i + 1] if i + 1 < len(argv) else "")
            i += 2
        elif a in ("-d", "--deep"):
            DEEP = 1; i += 1
        elif a in ("-s", "--security"):
            SECURITY = 1; i += 1
        elif a == "--zabbix":
            ZABBIX = 1; MODE = "zabbix"; SECURITY = 1; i += 1
        elif a in ("-v", "--verbose"):
            VERBOSE = 1; i += 1
        elif a in ("-h", "--help"):
            print_usage()
            return 0
        else:
            log_error(f"Unknown option: {a}")
            args_valid = False
            i += 1

    if not args_valid:
        print_usage(sys.stderr)
        return 1
    if os.geteuid() != 0:
        log_error("This script must be run as root to access /proc/*/maps")
        return 1

    try:
        return _run()
    finally:
        if WORKDIR and os.path.isdir(WORKDIR):
            shutil.rmtree(WORKDIR, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
