def log_verbose(msg):
    if VERBOSE:
        print(msg, file=sys.stderr)


def log_error(msg):
    print(f"ERROR: {msg}", file=sys.stderr)


def is_blacklisted(path):
    return any(p.search(path) for p in BLACKLIST_PATTERNS)


def is_excluded(service):
    return any(re.search(pat, service) for pat in EXCLUDE_PATTERNS)


# ---------------------------------------------------------------------------
# Container discovery
# ---------------------------------------------------------------------------

def read_procs():
    """Yield (pid, cgroup_path) pairs for processes in the cgroup v2 tree.

    cgroup_path is the path after the '0::' marker (e.g. /lxc/100/ns/init.scope).
    """
    try:
        entries = os.listdir("/proc")
    except OSError:
        return
    for e in entries:
        if not e.isdigit():
            continue
        try:
            with open(f"/proc/{e}/cgroup") as fh:
                data = fh.read()
        except OSError:
            continue
        for line in data.splitlines():
            if line.startswith("0::"):
                yield e, line[3:]
                break


def load_container_names():
    # Read names from the per-container config files instead of calling
    # `pct list`, which is slow (spawns a process and hits the cluster state).
    # Each /etc/pve/lxc/<CTID>.conf carries the container name in a `hostname:`
    # field (LXC uses `hostname:`, unlike QEMU's `name:`); the filename gives
    # the CTID. This is also robust under cron's minimal PATH (no /usr/sbin).
    for conf in glob.glob("/etc/pve/lxc/*.conf"):
        ctid = os.path.basename(conf)[:-len(".conf")]
        if not ctid.isdigit():
            continue
        name = ""
        try:
            with open(conf, errors="ignore") as fh:
                for line in fh:
                    if line.startswith("hostname:"):
                        name = line.split(":", 1)[1].strip()
                        break
        except OSError:
            continue
        if name:
            CT_NAMES[ctid] = name
    log_verbose(f"Loaded {len(CT_NAMES)} container names from /etc/pve/lxc")


def resolve_container_filter():
    """Resolve a -c/--container filter given as a name to its CTID.

    Numeric filters (CTIDs) are passed through unchanged. Names are resolved
    against the container list loaded by load_container_names(); this must run
    before scan_containers(). Returns 0 on success, non-zero on failure."""
    global CONTAINER_FILTER
    if not CONTAINER_FILTER or CONTAINER_FILTER.isdigit():
        return 0
    name = CONTAINER_FILTER
    matches = [ctid for ctid, cname in CT_NAMES.items() if cname == name]
    if not matches:
        log_error(f"Unknown container name: {name} (no such LXC container)")
        return 1
    if len(matches) > 1:
        log_error(f"Container name is ambiguous ({len(matches)} containers share "
                  f"the name '{name}'): {', '.join(matches)}; use a CTID instead")
        return 1
    CONTAINER_FILTER = matches[0]
    log_verbose(f"Resolved container name '{name}' to CTID {CONTAINER_FILTER}")
    return 0


def get_container_pids():
    for pid, path in read_procs():
        m = CGROUP_RE.match(path)
        if m and path.endswith("/ns/init.scope"):
            CT_PIDS[m.group(1)] = pid
    log_verbose(f"Found {len(CT_PIDS)} running containers")


# ---------------------------------------------------------------------------
# Library freshness checking
# ---------------------------------------------------------------------------

def parse_map_line(line):
    parts = line.split()
    # fields: addr perms offset dev inode path...
    if len(parts) < 6:
        return "", "", "", ""
    return parts[1], parts[3], parts[4], " ".join(parts[5:])


def read_maps(pid):
    try:
        with open(f"/proc/{pid}/maps") as fh:
            return fh.read().splitlines()
    except OSError:
        return []


def check_process_fast(pid, maps=None):
    """Fast check: look for (deleted) in /proc/<pid>/maps and /proc/<pid>/exe.
    Returns (needs_restart, found_libs)."""
    try:
        exe = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        return False, None
    if exe.endswith(" (deleted)"):
        clean = exe[:-len(" (deleted)")]
        if not is_blacklisted(clean):
            return True, clean + " (executable)"

    libs = set()
    for line in maps if maps is not None else read_maps(pid):
        perms, _dev, _ino, path = parse_map_line(line)
        if not path:
            continue
        # Any executable mapping (r-xp, rwxp, ...), not just exact "r-xp".
        if "x" in perms and "(deleted)" in path:
            clean = path[:-len(" (deleted)")] if path.endswith(" (deleted)") else path
            if not is_blacklisted(clean):
                libs.add(clean)
    if libs:
        return True, "\n".join(sorted(libs))
    return False, None


def check_process_deep(pid, init_pid):
    """Deep check: also compare inode numbers for shared libraries.
    Returns (needs_restart, found_libs)."""
    found = []
    maps = read_maps(pid)
    ok, libs = check_process_fast(pid, maps)
    if ok and libs:
        found.append(libs)

    for line in maps:
        perms, dev, inode, path = parse_map_line(line)
        if not path:
            continue
        if "x" not in perms:
            continue
        if is_blacklisted(path):
            continue
        if path.endswith(" (deleted)"):
            continue
        if ".so" not in path:
            continue
        try:
            inode_int = int(inode)
        except ValueError:
            continue
        if inode_int == 0:
            continue

        disk_path = f"/proc/{init_pid}/root{path}"
        if not os.path.exists(disk_path):
            continue
        try:
            st = os.stat(disk_path)
        except OSError:
            continue
        disk_inode = st.st_ino
        disk_dev = f"{os.major(st.st_dev)}:{os.minor(st.st_dev)}"

        maps_dev_clean = norm_dev(dev)
        disk_dev_clean = norm_dev(disk_dev)
        if inode_int != disk_inode and maps_dev_clean == disk_dev_clean:
            found.append(path + " (inode mismatch)")

    if found:
        return True, "\n".join(found)
    return False, None


def norm_dev(dev):
    parts = dev.split(":")
    if len(parts) != 2:
        return dev
    return f"{parts[0].lstrip('0') or '0'}:{parts[1].lstrip('0') or '0'}"


# ---------------------------------------------------------------------------
# Service extraction from a cgroup path
# ---------------------------------------------------------------------------

def service_from_path(path_suffix):
    """Map a cgroup path suffix to a systemd unit name, most specific first.

    Returns None for the container's own root cgroup (named ".lxc"), which
    holds processes that systemd did not place into a unit cgroup (cron jobs,
    manually spawned processes). Those are not restartable systemd services,
    so they are skipped rather than reported as a fake ".lxc" service."""
    if path_suffix == "init.scope":
        return "systemd-manager"
    if path_suffix == ".lxc":
        return None
    m = re.search(r"/([^/]+\.service)/init\.scope$", path_suffix)
    if m:
        return m.group(1)
    m = re.search(r"/([^/]+\.scope)$", path_suffix)
    if m:
        return m.group(1)
    m = re.search(r"(?:^|/)([^/]+\.service)$", path_suffix)
    if m:
        return m.group(1)
    m = re.search(r"(user@[0-9]+\.service)", path_suffix)
    if m:
        return m.group(1)
    m = re.search(r"user-([0-9]+)\.slice", path_suffix)
    if m:
        return f"user@{m.group(1)}.service"
    return path_suffix.rstrip("/").rsplit("/", 1)[-1]


def process_ident(pid):
    """Return a human-readable identifier (main script/executable) for a
    process that systemd did not place into a unit cgroup (i.e. the container's
    root .lxc cgroup). Prefers the script path when the process is launched via
    an interpreter. Returns None if it cannot be determined or is blacklisted."""
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            args = fh.read().split(b"\0")
    except OSError:
        return None
    args = [a.decode(errors="replace") for a in args if a]
    if not args:
        return None
    interp = os.path.basename(args[0]).lower()
    if interp.startswith(("python", "perl", "ruby", "php", "node", "nodejs")):
        ident = next((a for a in args[1:] if a.startswith("/")), args[0])
    else:
        ident = args[0]
    if is_blacklisted(ident):
        return None
    return ident


# ---------------------------------------------------------------------------
# Main scanning logic
# ---------------------------------------------------------------------------

def scan_containers():
    log_verbose("Scanning container processes for outdated libraries...")
    for pid, path in read_procs():
        m = CGROUP_RE.match(path)
        if not m:
            continue
        ctid = m.group(1)
        path_suffix = m.group(2)

        if CONTAINER_FILTER and ctid != CONTAINER_FILTER:
            continue

        # Detect processes inside a user session manager subtree
        # (user@N.service/<slice>/<unit>). Those units are managed by the
        # user's systemd, not PID 1, and must be restarted with
        # `systemctl --user` as the owning user.
        user_uid = ""
        mu = re.search(r"user@(\d+)\.service/[^/]+/", path_suffix)
        if mu:
            user_uid = mu.group(1)

        if path_suffix == ".lxc":
            # Processes in the container's root cgroup are not placed into a
            # systemd unit cgroup (leftovers from a service restart, manually
            # spawned processes, cron jobs). They cannot be restarted via
            # systemctl, so identify them by their main script/executable and
            # report them as non-systemd so the user can restart manually or
            # reboot the container.
            service = process_ident(pid)
            non_systemd = True
        else:
            service = service_from_path(path_suffix)
            non_systemd = False
        if not service:
            continue
        if is_excluded(service):
            continue

        # Deduplicate: key encodes owning user UID (empty for system units)
        key = f"{ctid}:{user_uid}:{service}"
        if key in CONT_SERVICES:
            continue

        init_pid = CT_PIDS.get(ctid, "")
        if not init_pid:
            for p2, pth2 in read_procs():
                m2 = CGROUP_RE.match(pth2)
                if m2 and m2.group(1) == ctid and pth2.endswith("/ns/init.scope"):
                    init_pid = p2
                    CT_PIDS[ctid] = p2
                    break

        if not os.access(f"/proc/{pid}/maps", os.R_OK):
            continue
        if not os.access(f"/proc/{pid}/exe", os.R_OK):
            continue

        log_verbose(f"Checking PID {pid} (CT {ctid}, {service})...")
        if DEEP:
            ok, libs = check_process_deep(pid, init_pid)
        else:
            ok, libs = check_process_fast(pid)

        if ok and libs:
            CONT_SERVICES[key] = libs
            if key not in CONT_PID:
                CONT_PID[key] = pid
            if non_systemd:
                NON_SYSTEMD_KEYS.add(key)
            log_verbose(f"  -> {service} in CT {ctid} needs restart")


# ---------------------------------------------------------------------------
# Verification and restart functions
# ---------------------------------------------------------------------------

def service_is_stale(ctid, service, user_uid):
    """Return True if any process for this service still uses outdated
    libraries (restart respected KillMode and left children running)."""
    for pid, path in read_procs():
        m = CGROUP_RE.match(path)
        if not m or m.group(1) != ctid:
            continue
        if not os.access(f"/proc/{pid}/maps", os.R_OK):
            continue
        if user_uid:
            if f"user@{user_uid}.service/" not in path:
                continue
            if not path.endswith("/" + service):
                continue
        else:
            if not path.endswith("/" + service):
                continue
            if "user@" in path:      # same-named user unit, different owner
                continue
        ok, _ = check_process_fast(pid)
        if ok:
            return True
    return False


def restart_dbus_dependents(ctid, ct_name):
    for dep in DBUS_DEPENDENT_SERVICES:
        try:
            r = subprocess.run(
                ["pct", "exec", ctid, "--", "systemctl", "is-active", "--quiet", dep],
                capture_output=True)
            if r.returncode != 0:
                continue
        except Exception:
            continue
        # Already in the restart list (handled by the main loop)
        if f"{ctid}::{dep}" in CONT_SERVICES:
            continue
        print(f"Container {ctid} ({ct_name}): restarting D-Bus dependent {dep} "
              f"(lost connection after dbus restart)")
        if DRY_RUN:
            print(f"  [DRY RUN] Would run: pct exec {ctid} -- systemctl restart {dep}")
            continue
        try:
            r = subprocess.run(["pct", "exec", ctid, "--", "systemctl", "restart", dep],
                               timeout=SUBPROC_TIMEOUT)
        except subprocess.TimeoutExpired:
            log_error(f"Timed out restarting {dep} in container {ctid}")
            continue
        if r.returncode:
            log_error(f"Failed to restart {dep} in container {ctid} "
                      f"(exit code: {r.returncode})")


def resolve_user(ctid, user_uid):
    try:
        r = subprocess.run(
            ["pct", "exec", ctid, "--", "getent", "passwd", user_uid],
            capture_output=True, text=True, timeout=SUBPROC_TIMEOUT)
    except subprocess.TimeoutExpired:
        log_error(f"Timed out looking up UID {user_uid} in container {ctid}")
        return ""
    if r.returncode == 0 and r.stdout:
        return r.stdout.split(":", 1)[0]
    return ""


def systemctl_cmd(ctid, action, service, user_uid="", username="", extra=()):
    cmd = ["pct", "exec", ctid, "--"]
    if user_uid:
        cmd += ["runuser", "-u", username, "--", "env",
                f"XDG_RUNTIME_DIR=/run/user/{user_uid}",
                "systemctl", "--user", action, *extra, service]
    else:
        cmd += ["systemctl", action, *extra, service]
    return cmd


def restart_with_escalation(ctid, ct_name, service, user_uid="", username=""):
    """restart a service, verify stale processes are gone, and escalate to
    kill + start, then SIGKILL + start if KillMode leaves children behind."""
    tool = "systemctl --user" if user_uid else "systemctl"

    def run(action, extra=()):
        cmd = systemctl_cmd(ctid, action, service, user_uid, username, extra)
        log_verbose("  Running: " + " ".join(cmd))
        try:
            return subprocess.run(cmd, timeout=SUBPROC_TIMEOUT).returncode
        except subprocess.TimeoutExpired:
            log_error(f"Timed out after {SUBPROC_TIMEOUT}s running {tool} {action} "
                      f"for {service} in container {ctid}")
            return 124

    # Step 1: normal restart (works for default KillMode=control-group)
    rc = run("restart")
    if rc:
        log_error(f"Failed to restart {service} in container {ctid} (exit code: {rc})")
        if not user_uid:
            try:
                r = subprocess.run(
                    ["pct", "exec", ctid, "--", "systemctl", "status", service],
                    capture_output=True, text=True, timeout=SUBPROC_TIMEOUT)
            except subprocess.TimeoutExpired:
                r = None
            if r:
                log_verbose("\n".join(r.stdout.splitlines()[-5:]))
        return

    # After restarting dbus.service, re-register its D-Bus dependents.
    if not user_uid and service == "dbus.service":
        restart_dbus_dependents(ctid, ct_name)

    # Step 2: verify the restart cleared the stale processes
    if not service_is_stale(ctid, service, user_uid):
        log_verbose(f"  Restart cleared stale processes for {service}")
        return

    # Step 3: escalate to kill + start (kill hits all cgroup processes)
    print(f"  -> Restart did not clear all processes (likely KillMode=process); "
          f"escalating to {tool} kill + start")
    run("kill")
    time.sleep(1)
    run("start")
    if not service_is_stale(ctid, service, user_uid):
        print(f"  -> Cleared via {tool} kill + start")
        return

    # Step 4: SIGTERM not enough; force kill
    print("  -> Processes survived SIGTERM; forcing SIGKILL")
    run("kill", ("--signal=SIGKILL",))
    time.sleep(1)
    run("start")
    if service_is_stale(ctid, service, user_uid):
        prefix = "User service" if user_uid else "Service"
        log_error(f"{prefix} {service} in container {ctid} still has stale "
                  f"processes after kill + start")
    else:
        print("  -> Cleared via SIGKILL + start")


def print_security_info(key):
    if key not in CONT_CVES:
        return
    for line in CONT_CVES[key].split("\n"):
        if line:
            print(f"  [security] {line}")


def print_cve_count_suffix(key):
    if not SECURITY or VERBOSE:
        return
    cve_count = CONT_CVE_COUNTS.get(key, 0)
    if cve_count <= 0:
        return
    plural = "" if cve_count == 1 else "s"
    print(f" ({cve_count} CVE{plural})", end="")


def print_security_annotation(key):
    if SECURITY and VERBOSE:
        print()
    else:
        print_cve_count_suffix(key)
        print()


def print_results():
    if not CONT_SERVICES:
        print("No containers have services needing restart.")
        return
    for key in sorted(CONT_SERVICES):
        ctid, _rest = key.split(":", 1)
        user_uid, service = _rest.split(":", 1)
        ct_name = CT_NAMES.get(ctid, "unknown")
        libs = CONT_SERVICES[key]
        if key in NON_SYSTEMD_KEYS:
            print(f"Container {ctid} ({ct_name}): non-systemd process {service} "
                  f"needs restart (restart it manually or reboot the container)", end="")
        else:
            svc_display = f"{service} [user session UID {user_uid}]" if user_uid else service
            print(f"Container {ctid} ({ct_name}): service {svc_display} needs restart", end="")
        print_security_annotation(key)
        if VERBOSE:
            for lib in libs.split("\n"):
                if lib:
                    print(f"  - {lib}")
        if SECURITY and VERBOSE:
            print_security_info(key)


def restart_one(key):
    """Restart a single flagged service, identified by its
    'ctid:user_uid:service' key. Handles non-systemd processes, the
    container's own systemd, scope units, user-session services and regular
    system services. Honors DRY_RUN."""
    ctid, _rest = key.split(":", 1)
    user_uid, service = _rest.split(":", 1)
    ct_name = CT_NAMES.get(ctid, "unknown")

    # Non-systemd processes (in the container root cgroup) cannot be
    # restarted via systemctl; report and leave the action to the user.
    if key in NON_SYSTEMD_KEYS:
        print(f"Container {ctid} ({ct_name}): non-systemd process {service} "
              f"needs restart (restart it manually or reboot the container)", end="")
        print_security_annotation(key)
        if SECURITY and VERBOSE:
            print_security_info(key)
        return

    # systemd-manager can be re-exec'd, no container reboot needed
    if service == "systemd-manager":
        print(f"Container {ctid} ({ct_name}): systemd needs reexec "
              f"(systemctl daemon-reexec)", end="")
        print_security_annotation(key)
        if SECURITY and VERBOSE:
            print_security_info(key)
        if DRY_RUN:
            print(f"  [DRY RUN] Would run: pct exec {ctid} -- systemctl daemon-reexec")
            return
        try:
            r = subprocess.run(["pct", "exec", ctid, "--", "systemctl", "daemon-reexec"],
                               timeout=SUBPROC_TIMEOUT)
        except subprocess.TimeoutExpired:
            log_error(f"Timed out daemon-reexec in container {ctid}")
            return
        if r.returncode:
            log_error(f"Failed to daemon-reexec in container {ctid} "
                      f"(exit code: {r.returncode})")
        return

    # Scope units cannot be restarted with systemctl restart
    if service.endswith(".scope"):
        if user_uid:
            print(f"Container {ctid} ({ct_name}): user session scope {service} "
                  f"has outdated processes (stopping via systemctl --user stop)", end="")
        else:
            print(f"Container {ctid} ({ct_name}): scope {service} has outdated "
                  f"processes (cannot auto-restart, consider restarting user "
                  f"service or terminating scope)", end="")
        print_security_annotation(key)
        if SECURITY and VERBOSE:
            print_security_info(key)
        if DRY_RUN:
            if user_uid:
                print(f"  [DRY RUN] Would run: pct exec {ctid} -- runuser -u <user> "
                      f"-- env XDG_RUNTIME_DIR=/run/user/{user_uid} "
                      f"systemctl --user stop {service}")
            else:
                print(f"  [DRY RUN] Would run: pct exec {ctid} -- systemctl stop {service}")
            return
        if user_uid:
            username = resolve_user(ctid, user_uid)
            if not username:
                log_error(f"Could not resolve username for UID {user_uid} in "
                          f"container {ctid}; skipping {service}")
                return
            cmd = systemctl_cmd(ctid, "stop", service, user_uid, username)
        else:
            cmd = ["pct", "exec", ctid, "--", "systemctl", "stop", service]
        log_verbose("  Stopping scope: " + " ".join(cmd))
        try:
            r = subprocess.run(cmd, timeout=SUBPROC_TIMEOUT)
        except subprocess.TimeoutExpired:
            log_error(f"Timed out stopping scope {service} in container {ctid}")
            return
        if r.returncode:
            log_error(f"Failed to stop scope {service} in container {ctid} "
                      f"(exit code: {r.returncode})")
        return

    # User session service (managed by user's systemd under user@N.service):
    # restart via `systemctl --user` as the owning user.
    if user_uid:
        print(f"Container {ctid} ({ct_name}): restarting user session service "
              f"{service} (UID {user_uid})", end="")
        print_security_annotation(key)
        if SECURITY and VERBOSE:
            print_security_info(key)
        if DRY_RUN:
            print(f"  [DRY RUN] Would run: pct exec {ctid} -- runuser -u <user> "
                  f"-- env XDG_RUNTIME_DIR=/run/user/{user_uid} "
                  f"systemctl --user restart {service}")
            print(f"  [DRY RUN] Would verify; if stale, escalate to: "
                  f"systemctl --user kill {service} && systemctl --user start {service}")
            return
        username = resolve_user(ctid, user_uid)
        if not username:
            log_error(f"Could not resolve username for UID {user_uid} in "
                      f"container {ctid}; skipping {service}")
            return
        restart_with_escalation(ctid, ct_name, service, user_uid, username)
        return

    # Standard system service
    print(f"Container {ctid} ({ct_name}): restarting service {service}", end="")
    print_security_annotation(key)
    if SECURITY and VERBOSE:
        print_security_info(key)
    if DRY_RUN:
        print(f"  [DRY RUN] Would run: pct exec {ctid} -- systemctl restart {service}")
        print(f"  [DRY RUN] Would verify; if stale, escalate to: "
              f"pct exec {ctid} -- systemctl kill {service} && systemctl start {service}")
        return
    restart_with_escalation(ctid, ct_name, service)


def restart_services():
    if not CONT_SERVICES:
        print("No containers have services needing restart.")
        return
    for key in sorted(CONT_SERVICES):
        restart_one(key)


def interactive_restart():
    """Present a whiptail checkbox list of the flagged services (mirroring
    needrestart's own UI) and restart only the services the user selects.
    Returns 0 on success, 1 if interactive mode is unavailable."""
    if not CONT_SERVICES:
        print("No containers have services needing restart.")
        return 0
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        log_error("Interactive mode needs a terminal; use -l to list or "
                  "-r to restart all services")
        return 1
    if not shutil.which("whiptail"):
        log_error("whiptail is not installed; use -l to list or -r to "
                  "restart all services")
        return 1

    # Size the dialog to the terminal so lines fit on screen. whiptail needs a
    # little margin around the box, and each row reserves ~8 columns for the
    # checkbox and borders, so long labels are truncated to fit.
    term = shutil.get_terminal_size()
    width = max(40, min(term.columns - 2, 100))
    max_label = max(10, width - 8)
    height = min(len(CONT_SERVICES) + 8, max(12, term.lines - 2))
    list_height = min(len(CONT_SERVICES), max(5, height - 8))

    # Build the checklist: tag = the 'ctid:user_uid:service' key (no spaces,
    # safe as a whiptail tag), item = human-readable label, status = ON so
    # every flagged service is pre-selected like needrestart does. The tag is
    # hidden with --notags so only the readable label is shown.
    items = []
    for key in sorted(CONT_SERVICES):
        ctid, _rest = key.split(":", 1)
        user_uid, service = _rest.split(":", 1)
        ct_name = CT_NAMES.get(ctid, "unknown")
        if key in NON_SYSTEMD_KEYS:
            label = f"{ct_name} ({ctid}): {service} (non-systemd)"
        elif user_uid:
            label = f"{ct_name} ({ctid}): {service} [user UID {user_uid}]"
        else:
            label = f"{ct_name} ({ctid}): {service}"
        if SECURITY:
            cve_count = CONT_CVE_COUNTS.get(key, 0)
            if cve_count > 0:
                plural = "" if cve_count == 1 else "s"
                label += f" ({cve_count} CVE{plural})"
        if len(label) > max_label:
            label = label[:max_label - 3] + "..."
        items.append((key, label, "ON"))

    cmd = ["whiptail", "--title", "needrestart-lxc: services to restart",
           "--notags", "--separate-output", "--checklist",
           "Select services to restart:", str(height), str(width), str(list_height)]
    for tag, label, status in items:
        cmd += [tag, label, status]

    # whiptail draws the dialog on stdout and writes the result to stderr, so
    # swap them: send the dialog to our stderr (the terminal) and capture the
    # selected tags from whiptail's stderr.
    r = subprocess.run(cmd, stdout=sys.stderr.fileno(), stderr=subprocess.PIPE)
    errmsg = r.stderr.decode(errors="replace").strip()
    if r.returncode == 255 and errmsg:
        log_error(f"whiptail failed: {errmsg}")
        return 1
    if r.returncode != 0:
        # 1 = Cancel button; 255 with no message = Esc key
        print("No services selected; nothing restarted.")
        return 0
    selected = [line for line in r.stderr.decode().splitlines() if line]
    if not selected:
        print("No services selected; nothing restarted.")
        return 0

    for key in selected:
        if key in CONT_SERVICES:
            restart_one(key)
    return 0


