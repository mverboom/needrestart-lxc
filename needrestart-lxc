#!/usr/bin/env python3
"""needrestart-lxc - Check LXC containers on Proxmox for processes using
outdated shared libraries, and optionally restart specific services
inside containers without restarting the entire container.

This script reads /proc/*/maps from the host to detect processes in
containers that are using deleted/replaced shared libraries. It maps
those processes to their container and systemd service using cgroup
information, and can restart individual services via `pct exec`.

It does NOT modify or depend on needrestart being installed inside
containers. It is a standalone tool that complements the host-side
needrestart by providing per-service granularity for LXC containers.

By default (no mode flag) it presents an interactive whiptail checkbox
list of the services needing restart, mirroring needrestart's own UI, and
restarts only the services the user selects. Use -l/--list for a plain
non-interactive text report, or -r/--restart to restart every flagged
service without prompting (for automation).
"""

import gzip
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

# Ensure pct (in /usr/sbin) is found even when run from a minimal
# environment such as cron (PATH=/usr/bin:/bin), where /usr/sbin is missing
# and container names would silently be lost.
os.environ["PATH"] = (
    "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    + ":" + os.environ.get("PATH", "")
)

PROGNAME = "needrestart-lxc"

# cgroup v2 path of a process inside an LXC container (after the "0::" marker)
CGROUP_RE = re.compile(r"^/lxc/(\d+)/ns/(.+)$")

# Special device / tmp paths to ignore (needrestart: blacklist_mappings, etc.)
BLACKLIST_PATTERNS = [re.compile(p) for p in (
    r"^/memfd:",
    r"^/dev/",
    r"^/SYSV[0-9a-fA-F]{8}",                    # SysV shared memory segments
    r"^/\[aio\]",
    r"^\[",
    r"^(/var)?/tmp/",
    r"^(/var)?/run/",
    r"/orcexec\.[\w\d]+( \(deleted\))?$",      # Oil Runtime Compiler JIT
    r"/jna[0-9]+\.tmp( \(deleted\))?$",        # Java Native Access temp files
    r"/\.cache/JNA/",
    r"^/usr/bin/sudo",                          # not daemons
    r"^/usr/bin/apt-get",
)]

# Services that register well-known D-Bus names on the system bus. When
# dbus.service is restarted they lose their connection to the old daemon but
# keep running, causing D-Bus activation timeouts (e.g. pam_systemd.so hanging
# 25s during SSH login via systemd-logind). Restart them after dbus.
DBUS_DEPENDENT_SERVICES = [
    "systemd-logind.service",
    "polkit.service",
    "avahi-daemon.service",
    "systemd-networkd.service",
    "systemd-resolved.service",
    "wpa_supplicant.service",
    "NetworkManager.service",
    "rtkit-daemon.service",
    "colord.service",
    "accounts-daemon.service",
    "ModemManager.service",
]

# Security scan configuration (CVE analysis)
CACHE_TTL = 86400                     # seconds to keep cached API responses
CACHE_DIR = "/var/cache/needrestart-lxc"
SUBPROC_TIMEOUT = 120                 # seconds; pct exec can hang on frozen
                                      # containers, which would pile up cron runs

# Modes / flags
MODE = "interactive"   # default: whiptail checkbox selection
VERBOSE = 0
DEEP = 0
DRY_RUN = 0
SECURITY = 0
ZABBIX = 0
CONTAINER_FILTER = ""
EXCLUDE_PATTERNS = []

# Collected data structures
CT_NAMES = {}          # ctid -> container name
CT_PIDS = {}           # ctid -> init PID
CONT_SERVICES = {}     # "ctid:user_uid:service" -> "deleted_lib1,deleted_lib2"
CONT_PID = {}          # "ctid:user_uid:service" -> PID of first stale process
NON_SYSTEMD_KEYS = set()  # "ctid:user_uid:service" -> process in the .lxc root cgroup (not a systemd service)
CONT_CVES = {}         # key -> security analysis lines
CONT_CVE_COUNTS = {}   # key -> total CVEs fixed
CONT_UPDATE_COUNTS = {}  # "ctid|srcpkg|old|new" -> CVEs fixed by this update
CT_CVE_UNKNOWN = set()  # ctids where CVE analysis failed (data indeterminate)
CT_OS_ID = {}          # ctid -> os id (debian/ubuntu/...)
CT_OS_RELEASE = {}     # ctid -> VERSION_ID (e.g. 12, 22.04)
CT_OS_CODENAME = {}    # ctid -> VERSION_CODENAME (e.g. bookworm, jammy)
EXT_VERDICTS = {}      # "ctid|srcpkg|old|new" -> cached verdict line
CT_NOTES = {}          # ctid -> reason why analysis was skipped


