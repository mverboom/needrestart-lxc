#!/bin/sh
# Return the latest needrestart-lxc Zabbix JSON (generated by cron as root);
# an empty document if the scan has not run yet. This keeps the Zabbix agent
# check instant (<1s) even though the scan itself takes several seconds.
if [ -r /var/cache/needrestart-lxc/zabbix.json ]; then
   cat /var/cache/needrestart-lxc/zabbix.json
else
   echo '{"containers":[]}'
fi
