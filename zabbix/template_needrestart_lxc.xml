<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>7.0</version>
    <template_groups>
        <template_group>
            <uuid>2684640b29494617bd5fcd5cb526d9b4</uuid>
            <name>Templates</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>803febd863dc4a1fbe1bf872e6ce0e78</uuid>
            <template>Template needrestart lxc</template>
            <name>Template needrestart lxc</name>
            <description>Per-container restart alerts for LXC containers on Proxmox VE, based on the needrestart-lxc script. Discovers every running container and reports how many services need a restart and how many CVEs the pending updates fix.

Requires on the monitored host:
  - the needrestart-lxc script (with --zabbix support) at /usr/local/bin/needrestart-lxc
  - a sudoers entry: zabbix ALL=(root) NOPASSWD:/usr/local/bin/needrestart-lxc
  - agent2 UserParameter: needrestart.lxc.master,sudo -n /usr/local/bin/needrestart-lxc --zabbix

The master item runs once per hour; the discovery rule and per-container items are dependent on it.</description>
            <groups>
                <group>
                    <name>Templates</name>
                </group>
            </groups>
            <items>
                <item>
                    <uuid>25bd68841ded42af9714723f4c568d55</uuid>
                    <name>Needrestart LXC master</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>needrestart.lxc.master</key>
                    <delay>1h</delay>
                    <history>31d</history>
                    <trends>0</trends>
                    <value_type>TEXT</value_type>
                    <description>JSON document with one entry per running LXC container: ctid, name, services (needing restart), cves (fixed by pending updates) and human-readable details. Generated by needrestart-lxc --zabbix.</description>
                </item>
            </items>
            <discovery_rules>
                <discovery_rule>
                    <uuid>832f650414874fc6ad706aa3edcf46e3</uuid>
                    <name>Needrestart LXC discovery</name>
                    <type>DEPENDENT</type>
                    <key>needrestart.lxc.discovery</key>
                    <delay>0</delay>
                    <master_item>
                        <key>needrestart.lxc.master</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.containers</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>c99d141c1e82414fa58542aa34346cd2</uuid>
                            <name>Needrestart LXC {#CTNAME}: services to restart</name>
                            <type>DEPENDENT</type>
                            <key>needrestart.lxc.services[{#CTID}]</key>
                            <delay>0</delay>
                            <history>31d</history>
                            <trends>365d</trends>
                            <value_type>UNSIGNED</value_type>
                            <master_item>
                                <key>needrestart.lxc.master</key>
                            </master_item>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                <parameter>$.containers[?(@.ctid == "{#CTID}")].first()</parameter>
                            </parameters>
                                </step>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                <parameter>$.services</parameter>
                            </parameters>
                                </step>
                            </preprocessing>
                            <description>Number of services inside the container that run with outdated shared libraries and need a restart.</description>
                        </item_prototype>
                        <item_prototype>
                            <uuid>347ac59c01354253a4d2a30855d7bf45</uuid>
                            <name>Needrestart LXC {#CTNAME}: CVEs fixed</name>
                            <type>DEPENDENT</type>
                            <key>needrestart.lxc.cves[{#CTID}]</key>
                            <delay>0</delay>
                            <history>31d</history>
                            <trends>365d</trends>
                            <value_type>UNSIGNED</value_type>
                            <master_item>
                                <key>needrestart.lxc.master</key>
                            </master_item>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                <parameter>$.containers[?(@.ctid == "{#CTID}")].first()</parameter>
                            </parameters>
                                </step>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                <parameter>$.cves</parameter>
                            </parameters>
                                </step>
                            </preprocessing>
                            <description>Number of CVEs fixed by the pending updates that require a service restart in the container.</description>
                        </item_prototype>
                        <item_prototype>
                            <uuid>92b76670c978402791658419100f6693</uuid>
                            <name>Needrestart LXC {#CTNAME}: details</name>
                            <type>DEPENDENT</type>
                            <key>needrestart.lxc.details[{#CTID}]</key>
                            <delay>0</delay>
                            <history>31d</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                            <master_item>
                                <key>needrestart.lxc.master</key>
                            </master_item>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                <parameter>$.containers[?(@.ctid == "{#CTID}")].first()</parameter>
                            </parameters>
                                </step>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                <parameter>$.details</parameter>
                            </parameters>
                                </step>
                            </preprocessing>
                            <description>Human-readable summary of which services need a restart and which CVEs are fixed (per package, with data source).</description>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <uuid>e08734a7cb61418497f02a436e73225b</uuid>
                            <expression>last(/Template needrestart lxc/needrestart.lxc.services[{#CTID}])&gt;0 and last(/Template needrestart lxc/needrestart.lxc.cves[{#CTID}])=0</expression>
                            <name>{#CTNAME}: {ITEM.VALUE1} services need restart</name>
                            <opdata>{ITEM.VALUE2} CVEs</opdata>
                            <priority>WARNING</priority>
                            <description>Services inside the container run with outdated shared libraries; no known security fixes are pending. Restart the affected services (see the details item for specifics).</description>
                        </trigger_prototype>
                        <trigger_prototype>
                            <uuid>279fa24d2697487ebbbc0beb77d7feb0</uuid>
                            <expression>last(/Template needrestart lxc/needrestart.lxc.services[{#CTID}])&gt;0 and last(/Template needrestart lxc/needrestart.lxc.cves[{#CTID}])&gt;0</expression>
                            <name>{#CTNAME}: {ITEM.VALUE1} services need restart</name>
                            <opdata>{ITEM.VALUE2} CVEs</opdata>
                            <priority>HIGH</priority>
                            <description>Pending updates in the container fix known CVEs; restart the affected services to apply them (see the details item for the CVE list).</description>
                        </trigger_prototype>
                    </trigger_prototypes>
                    <lld_macro_paths>
                        <lld_macro_path>
                            <lld_macro>{#CTID}</lld_macro>
                            <path>$.ctid</path>
                        </lld_macro_path>
                        <lld_macro_path>
                            <lld_macro>{#CTNAME}</lld_macro>
                            <path>$.name</path>
                        </lld_macro_path>
                    </lld_macro_paths>
                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>
